      --cmd-max-angular-rps "${WEBRTC_CMD_MAX_ANGULAR_RPS:-1.0}" \
      --cmd-watchdog-timeout "${WEBRTC_CMD_WATCHDOG_TIMEOUT:-0.3}" \
      --cmd-rate-limit-hz "${WEBRTC_CMD_RATE_LIMIT_HZ:-100.0}" \
      --cmd-max-age-ms "${WEBRTC_CMD_MAX_AGE_MS:-2000.0}" \
      --cmd-max-future-ms "${WEBRTC_CMD_MAX_FUTURE_MS:-5000.0}" \
      --adaptive-bitrate "${WEBRTC_ADAPTIVE_BITRATE:-1}" \
      --min-bitrate-kbit "${WEBRTC_MIN_BITRATE_KBIT:-1000}" \
      --max-bitrate-kbit "${WEBRTC_MAX_BITRATE_KBIT:-6000}" \
      --bitrate-step-kbit "${WEBRTC_BITRATE_STEP_KBIT:-500}" \
      --bitrate-check-sec "${WEBRTC_BITRATE_CHECK_SEC:-2.0}" \
      --bitrate-bad-loss "${WEBRTC_BITRATE_BAD_LOSS:-0.08}" \
      --bitrate-good-loss "${WEBRTC_BITRATE_GOOD_LOSS:-0.02}" \
      --bitrate-bad-rtt-ms "${WEBRTC_BITRATE_BAD_RTT_MS:-350.0}" \
      --bitrate-good-rtt-ms "${WEBRTC_BITRATE_GOOD_RTT_MS:-150.0}" \
      --bitrate-good-samples "${WEBRTC_BITRATE_GOOD_SAMPLES:-3}" \
      "${optional_args[@]}" \
      --duration "${WEBRTC_DURATION:-0}"
    done
    return
  fi
  if [[ -n "${HORUS_WEBRTC_ADDITIONAL_ROOMS:-}" ]]; then
