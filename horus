#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="${HORUS_RUN_DIR:-${ROOT}/.run}"
ENV_FILE="${HORUS_ENV:-${ROOT}/.env}"
mkdir -p "${RUN_DIR}"
NEW_SERVICES=()

export HORUS_TERMINAL_ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-}"
export HORUS_TERMINAL_ROS_DISTRO="${ROS_DISTRO:-}"
export HORUS_TERMINAL_ROS_SETUP_PATH="${ROS_SETUP_PATH:-}"
export HORUS_TERMINAL_RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-}"
export HORUS_TERMINAL_ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-}"
export HORUS_TERMINAL_ROS_AUTOMATIC_DISCOVERY_RANGE="${ROS_AUTOMATIC_DISCOVERY_RANGE:-}"
export HORUS_TERMINAL_ROS_STATIC_PEERS="${ROS_STATIC_PEERS:-}"
export HORUS_TERMINAL_ROS_DISCOVERY_SERVER="${ROS_DISCOVERY_SERVER:-}"
export HORUS_TERMINAL_CYCLONEDDS_URI="${CYCLONEDDS_URI:-}"
export HORUS_TERMINAL_FASTRTPS_DEFAULT_PROFILES_FILE="${FASTRTPS_DEFAULT_PROFILES_FILE:-}"

# ANSI color helpers
RESET="\033[0m"
BOLD="\033[1m"
FG_GREEN="\033[38;5;48m"
FG_YELLOW="\033[38;5;214m"
FG_RED="\033[38;5;203m"
FG_BLUE="\033[38;5;39m"
FG_CYAN="\033[38;5;51m"
FG_MUTED="\033[38;5;244m"

log_success() {
  echo -e "${FG_GREEN}OK${RESET}      $*"
}
log_info() {
  echo -e "${FG_BLUE}Info${RESET}    $*"
}
log_warn() {
  echo -e "${FG_YELLOW}Warning${RESET} $*"
}
log_error() {
  echo -e "${FG_RED}Error${RESET}   $*" >&2
}
log_run() {
  echo -e "${FG_CYAN}Run${RESET}     $*"
}

print_banner() {
  echo ""
  echo -e "${BOLD}${FG_CYAN}HORUS Connector${RESET}"
  echo -e "${FG_MUTED}Robot management transport layer${RESET}"
  echo ""
}

print_banner_small() {
  echo -e "${BOLD}${FG_CYAN}HORUS Connector${RESET} ${FG_MUTED}v$(cat "${ROOT}/VERSION" 2>/dev/null || echo "1.x")${RESET}"
}

usage() {
  print_banner

  echo -e "${BOLD}Usage${RESET}"
  echo -e "  ./horus ${FG_GREEN}<command>${RESET} ${FG_CYAN}[options]${RESET}\n"

  echo -e "${BOLD}Commands${RESET}"
  echo -e "  ${FG_GREEN}setup${RESET}                             Guided setup wizard"
  echo -e "  ${FG_GREEN}init${RESET}                              Create .env from the template"
  echo -e "  ${FG_GREEN}bootstrap${RESET} ${FG_CYAN}[role]${RESET}                  Install dependencies for a connector role"
  echo -e "  ${FG_GREEN}update-zenoh${RESET} ${FG_CYAN}[version]${RESET}           Update only the project-local bridge"
  echo -e "  ${FG_GREEN}environment${RESET}                       Print non-secret software/version report"
  echo -e "  ${FG_GREEN}reprobe${RESET} ${FG_CYAN}[robot|machine]${RESET}         Refresh the selected codec profile"
  echo -e "  ${FG_GREEN}launch${RESET} ${FG_CYAN}[role] [--no-monitor] [--skip-dds-preflight]${RESET} Start services and open the live console"
  echo -e "  ${FG_GREEN}stop${RESET}                              Stop running services"
  echo -e "  ${FG_GREEN}status${RESET} ${FG_CYAN}[--json]${RESET}                  Show service state and runtime settings"
  echo -e "  ${FG_GREEN}monitor${RESET} ${FG_CYAN}[--once]${RESET}                  Interactive live console"
  echo -e "  ${FG_GREEN}doctor${RESET} ${FG_CYAN}[role]${RESET}                    Check connectivity and listeners"
  echo -e "  ${FG_GREEN}quic${RESET} ${FG_CYAN}[setup-server|install-cert|status]${RESET} Configure Zenoh QUIC TLS"
  echo -e "  ${FG_GREEN}logs${RESET} ${FG_CYAN}[service]${RESET}                   Stream a service log"
  echo -e "  ${FG_GREEN}metrics${RESET} ${FG_CYAN}[--port 9418]${RESET}             Export Prometheus metrics and status JSON"
  echo -e "  ${FG_GREEN}fleet${RESET} ${FG_CYAN}[launch|stop|status] <file>${RESET} Start multiple rooms from one config"
  echo -e "  ${FG_GREEN}fake-data${RESET} ${FG_CYAN}[robot_id]${RESET}              Publish synthetic ROS 2 camera/state topics"
  echo ""

  echo -e "${BOLD}Roles${RESET}"
  echo -e "  ${BOLD}robot${RESET}     Robot-side system. Sends camera/state and receives velocity commands"
  echo -e "  ${BOLD}machine${RESET}   Operator/local machine. Receives camera/state and sends commands"
  echo -e "  ${BOLD}teammate${RESET}  Field teammate relay. Publishes HoloLens pose/FPV and receives guidance"
  echo -e "  ${BOLD}cloud${RESET}     Shared Zenoh router + WebRTC signaling relay, optionally TURN"
  echo ""

  echo -e "${BOLD}Topologies${RESET}"
  echo -e "  ${BOLD}hub${RESET}       Robot(s) and machine(s) connect through one cloud hub"
  echo -e "  ${BOLD}direct${RESET}    Robot connects directly to machine over VPN, Tailscale, or LAN"
  echo ""

  echo -e "${FG_MUTED}Start with ${BOLD}./horus setup${RESET}${FG_MUTED}, then run ${BOLD}./horus bootstrap <role>${RESET}${FG_MUTED} and ${BOLD}./horus launch <role>${RESET}${FG_MUTED}.${RESET}\n"
}

trim_spaces() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "${value}"
}

load_key_value_file() {
  source "${ROOT}/scripts/config_env.sh"
  horus_load_config "$1" "$(python_bin)"
}

load_env() {
  if [[ ! -f "${ENV_FILE}" ]]; then
    echo "Missing ${ENV_FILE}. Run ./horus init first." >&2
    exit 1
  fi
  load_key_value_file "${ENV_FILE}"
  if [[ -f "${ROOT}/.zenoh_profile.env" ]]; then
    load_key_value_file "${ROOT}/.zenoh_profile.env"
  fi
  if [[ -f "${ROOT}/.zenoh_tls_profile.env" ]]; then
    load_key_value_file "${ROOT}/.zenoh_tls_profile.env"
  fi
}

source_ros() {
  local distro="${ROS_DISTRO:-jazzy}"
  if [[ -n "${ROS_SETUP_PATH:-}" ]]; then
    local setup_path="${ROS_SETUP_PATH/#\~/${HOME}}"
    if [[ -f "${setup_path}" ]]; then
      set +u
      # shellcheck source=/dev/null
      source "${setup_path}"
      set -u
      return
    fi
    echo "ROS_SETUP_PATH is set but the file does not exist: ${ROS_SETUP_PATH}" >&2
    return 1
  elif [[ -f "/opt/ros/${distro}/setup.bash" ]]; then
    set +u
    # shellcheck source=/dev/null
    source "/opt/ros/${distro}/setup.bash"
    set -u
  elif [[ -f "/opt/ros/${distro}/local_setup.bash" ]]; then
    set +u
    # shellcheck source=/dev/null
    source "/opt/ros/${distro}/local_setup.bash"
    set -u
  else
    echo "ROS setup file not found for ${distro}: /opt/ros/${distro}/setup.bash or local_setup.bash" >&2
    return 1
  fi
}

source_ros_required() {
  source_ros || exit 1
}

python_bin() {
  local py="${HORUS_WEBRTC_PYTHON:-${WEBRTC_VENV:-${ROOT}/.venv-webrtc}/bin/python}"
  if [[ ! -x "${py}" ]]; then
    echo "python3"
    return
  fi

  if [[ "${WEBRTC_MEDIA_MODE:-h264}" == "jpeg" ]]; then
    if "${py}" - <<'PY' >/dev/null 2>&1
import aiortc
import numpy
import PIL
import websockets
PY
    then
      echo "${py}"
      return
    fi
  elif "${py}" - <<'PY' >/dev/null 2>&1
try:
    import websockets
except Exception:
    import websocket
PY
  then
    echo "${py}"
    return
  fi

  echo "python3"
}

signal_python_bin() {
  local py="${HORUS_WEBRTC_PYTHON:-${WEBRTC_VENV:-${ROOT}/.venv-webrtc}/bin/python}"
  if [[ -x "${py}" ]] && "${py}" - <<'PY' >/dev/null 2>&1
import websockets
PY
  then
    echo "${py}"
    return
  fi

  echo "python3"
}

build_ice_args() {
  local -n output_ref="$1"
  local ice="${WEBRTC_ICE_SERVERS:-stun:stun.l.google.com:19302}"
  IFS=',' read -ra servers <<< "${ice}"
  for server in "${servers[@]}"; do
    [[ -n "${server}" ]] && output_ref+=(--ice-server "${server}")
  done
}

build_webrtc_latency_probe_args() {
  local -n output_ref="$1"
  if [[ "${WEBRTC_LATENCY_PROBE:-0}" == "1" ]]; then
    output_ref+=(--latency-probe --latency-probe-rate "${WEBRTC_LATENCY_PROBE_RATE:-60.0}")
  fi
}

build_webrtc_latency_receiver_args() {
  local -n output_ref="$1"
  output_ref+=(
    --fresh-deadline-ms "${WEBRTC_FRESH_DEADLINE_MS:-150.0}"
  )
  if [[ -n "${WEBRTC_CLOCK_OFFSET_MS:-}" ]]; then
    output_ref+=(--clock-offset-ms "${WEBRTC_CLOCK_OFFSET_MS}")
  elif [[ -n "${WEBRTC_CLOCK_OFFSET_JSON:-}" ]]; then
    output_ref+=(--clock-offset-json "${WEBRTC_CLOCK_OFFSET_JSON}")
  fi
  if [[ "${WEBRTC_LATENCY_PROBE:-0}" == "1" || -n "${WEBRTC_LATENCY_JSON:-}" ]]; then
    output_ref+=(--latency-json "${WEBRTC_LATENCY_JSON:-${RUN_DIR}/webrtc_latency.json}")
  fi
}

required_value() {
  local name="$1"
  local value="$2"
  if [[ -z "${value}" ]]; then
    echo "${name} is not set in ${ENV_FILE}" >&2
    exit 1
  fi
}

zenoh_config_path() {
  local configured="${ZENOH_CONFIG:-auto}"
  if [[ "${configured}" == "auto" || "${configured}" == "config/zenoh_split.json5" ]]; then
    case "${HORUS_ROLE:-}" in
      robot) configured="config/zenoh_robot.json5" ;;
      machine) configured="config/zenoh_machine.json5" ;;
      teammate) configured="config/zenoh_teammate.json5" ;;
      cloud) configured="config/zenoh_cloud.json5" ;;
      *) configured="config/zenoh_split.json5" ;;
    esac
  fi
  configured="${configured/#\~/${HOME}}"
  if [[ "${configured}" == /* ]]; then
    printf '%s\n' "${configured}"
  else
    printf '%s\n' "${ROOT}/${configured}"
  fi
}

zenoh_runtime_config_path() {
  local base="$1"
  local out="${RUN_DIR}/zenoh_runtime_${HORUS_ROLE:-default}.json5"
  local render_args=(--base "${base}" --out "${out}")

  if zenoh_tls_file_exists "${ZENOH_TLS_ROOT_CA:-}"; then
    render_args+=(--root-ca "${ZENOH_TLS_ROOT_CA/#\~/${HOME}}")
    render_args+=(--verify-name-on-connect "${ZENOH_TLS_VERIFY_NAME:-0}")
  fi
  if zenoh_tls_file_exists "${ZENOH_TLS_LISTEN_KEY:-}" && zenoh_tls_file_exists "${ZENOH_TLS_LISTEN_CERT:-}"; then
    render_args+=(
      --listen-private-key "${ZENOH_TLS_LISTEN_KEY/#\~/${HOME}}"
      --listen-certificate "${ZENOH_TLS_LISTEN_CERT/#\~/${HOME}}"
    )
  fi

  if [[ "${#render_args[@]}" -gt 4 ]]; then
    "$(python_bin)" "${ROOT}/scripts/render_zenoh_config.py" "${render_args[@]}" || return 1
    echo "${out}"
  else
    echo "${base}"
  fi
}

zenoh_routing_config() {
  local config
  config="$(zenoh_config_path)"
  [[ -f "${config}" ]] || { echo "Missing Zenoh config: ${config}" >&2; exit 1; }
  if [[ "${HORUS_ROLE:-}" =~ ^(robot|machine)$ ]] && \
     [[ -n "${HORUS_ROUTES_CONFIG:-}" || "${HORUS_ZENOH_CAMERA_POLICY:-compatible}" == "configured" ]]; then
    local rendered="${RUN_DIR}/zenoh_routes.json" route_args=() streams="[]"
    [[ -z "${HORUS_ROUTES_CONFIG:-}" ]] || route_args=(--routes "${HORUS_ROUTES_CONFIG}")
    if [[ "${HORUS_ROLE:-}" == "robot" && "${HORUS_ZENOH_CAMERA_POLICY:-compatible}" == "configured" ]]; then
      streams="$("$(python_bin)" "${ROOT}/scripts/webrtc_streams.py" json --root "${ROOT}" --role robot)" || return 1
    fi
    "$(python_bin)" "${ROOT}/scripts/transport_policy.py" --base "${config}" --out "${rendered}" --streams "${streams}" \
      --role "${HORUS_ROLE:-machine}" "${route_args[@]}" || return 1
    config="${rendered}"
  fi
  printf '%s\n' "${config}"
}

build_zenoh_common_args() {
  local -n output_ref="$1"
  local config
  config="$(zenoh_routing_config)" || return 1
  if zenoh_priority_links; then
    if zenoh_quic_active; then
      log_error "Priority-isolated TCP links require ZENOH_TRANSPORT=tcp (or auto without QUIC)."
      return 1
    fi
    local linked="${RUN_DIR}/zenoh_priority_links.json"
    "$(python_bin)" "${ROOT}/scripts/link_profile.py" --base "${config}" --out "${linked}" \
      --target "$(zenoh_connect_target "${HORUS_ROLE:-robot}")" --port "${ZENOH_PORT:-7447}" \
      --send-buffer "${HORUS_ZENOH_TCP_SEND_BUFFER:-65536}" || return 1
    config="${linked}"
  fi
  if zenoh_quic_active; then
    config="$(zenoh_runtime_config_path "${config}")"
  fi
  output_ref+=(-c "${config}")
  if [[ -n "${ZENOH_NAMESPACE:-}" ]]; then
    output_ref+=(-n "${ZENOH_NAMESPACE}")
  fi
}

dds_preflight_target() {
  local role="$1"
  zenoh_connect_target "${role}" 2>/dev/null || echo ""
}

dds_preflight_common_args() {
  local -n output_ref="$1"
  local role="$2"
  local mode="$3"
  local config
  local target
  config="$(zenoh_routing_config)" || return 1
  target="$(dds_preflight_target "${role}")"
  output_ref+=(
    --root "${ROOT}"
    --run-dir "${RUN_DIR}"
    --role "${role}"
    --mode "${mode}"
    --runtime "${ZENOH_BRIDGE_RUNTIME:-binary}"
    --topology "${HORUS_TOPOLOGY:-hub}"
    --zenoh-config "${config}"
    --target "${target}"
    --docker-network "host"
    --output-json "${RUN_DIR}/dds_preflight.json"
  )
}

run_dds_preflight() {
  local role="$1"
  local mode="$2"
  local args=()
  dds_preflight_common_args args "${role}" "${mode}"
  python3 "${ROOT}/scripts/dds_preflight.py" "${args[@]}" --pretty
}

run_dds_launch_gate() {
  local role="$1"
  if [[ "${HORUS_SKIP_DDS_PREFLIGHT:-0}" == "1" ]]; then
    log_warn "Skipping DDS preflight because HORUS_SKIP_DDS_PREFLIGHT=1."
    return
  fi
  log_info "Running DDS preflight."
  run_dds_preflight "${role}" launch
}

dds_connector_config_path() {
  local role="$1"
  local args=()
  dds_preflight_common_args args "${role}" render
  python3 "${ROOT}/scripts/dds_preflight.py" "${args[@]}" --warn-only | tail -n 1
}

dds_connector_uri() {
  local role="$1"
  if [[ -n "${CYCLONEDDS_URI:-}" ]]; then
    printf '%s\n' "${CYCLONEDDS_URI}"
    return
  fi
  printf 'file://%s\n' "$(dds_connector_config_path "${role}")"
}

dds_connector_docker_args() {
  local -n output_ref="$1"
  local role="$2"
  local uri="${CYCLONEDDS_URI:-}"
  local path

  if [[ -n "${uri}" ]]; then
    if [[ "${uri}" == file://* ]]; then
      path="${uri#file://}"
    else
      path="${uri}"
      uri="file://${path}"
    fi
    path="${path/#\~/${HOME}}"
    [[ -f "${path}" ]] || { echo "CYCLONEDDS_URI points to a missing file: ${CYCLONEDDS_URI}" >&2; exit 1; }
    output_ref+=(-e "CYCLONEDDS_URI=file:///horus_cyclonedds.xml" -v "${path}:/horus_cyclonedds.xml:ro")
    return
  fi

  path="$(dds_connector_config_path "${role}")"
  output_ref+=(-e "CYCLONEDDS_URI=file:///horus_cyclonedds.xml" -v "${path}:/horus_cyclonedds.xml:ro")
}

dds_docker_env_args() {
  local -n output_ref="$1"
  local key
  for key in \
    ROS_DISTRO \
    ROS_DOMAIN_ID \
    ROS_LOCALHOST_ONLY \
    ROS_AUTOMATIC_DISCOVERY_RANGE \
    ROS_STATIC_PEERS \
    RMW_IMPLEMENTATION \
    FASTRTPS_DEFAULT_PROFILES_FILE; do
    if [[ -n "${!key:-}" ]]; then
      output_ref+=(-e "${key}=${!key}")
    fi
  done
}

zenoh_transport() {
  local mode="${ZENOH_TRANSPORT:-auto}"
  mode="${mode,,}"
  case "${mode}" in
    auto|tcp|quic) echo "${mode}" ;;
    *)
      log_warn "Unknown ZENOH_TRANSPORT=${ZENOH_TRANSPORT}; using auto."
      echo "auto"
      ;;
  esac
}

zenoh_priority_links() {
  [[ "${HORUS_ZENOH_TRAFFIC_LANES:-0}" == "1" ]]
}

zenoh_bulk_rate() {
  local rate="${HORUS_ZENOH_BULK_BYTES_PER_SECOND:-0}"
  [[ "${rate}" =~ ^[0-9]{1,10}$ ]] && ((10#${rate} <= 1073741824)) || {
    log_error "HORUS_ZENOH_BULK_BYTES_PER_SECOND must be 0..1073741824 (0 disables pacing)." >&2; return 1;
  }
  if ((10#${rate} > 0)) || [[ -n "${HORUS_ZENOH_BULK_BUDGET_FILE:-}" ]]; then
    ! zenoh_uses_docker || { log_error "Bulk pacing requires the native priority bridge build." >&2; return 1; }
    [[ -f "${ZENOH_BRIDGE_BINARY:-${ROOT}/zenoh-bridge-ros2dds}.source.json" ]] || {
      log_error "Bulk pacing requires the native bridge built by scripts/build_priority_bridge.py." >&2; return 1;
    }
  fi
  if [[ -n "${HORUS_ZENOH_BULK_BUDGET_FILE:-}" ]]; then
    if ! python3 - "${ZENOH_BRIDGE_BINARY:-${ROOT}/zenoh-bridge-ros2dds}.source.json" <<'PY'
import json
import sys
try:
    with open(sys.argv[1]) as stream:
        receipt = json.load(stream)
    sys.exit(0 if "zenoh-plugin-ros2dds/src/bulk_budget.rs" in receipt.get("new_files", []) else 1)
except (OSError, ValueError, TypeError):
    sys.exit(1)
PY
    then
      log_error "The selected bridge has no shared bulk-budget support. Rebuild with scripts/build_priority_bridge.py." >&2
      return 1
    fi
  fi
  printf '%d\n' "$((10#${rate}))"
}

zenoh_transport_label() {
  case "$(zenoh_transport)" in
    auto)
      if zenoh_quic_ready_any; then
        echo "auto (quic + tcp fallback)"
      elif zenoh_auto_quic_enabled; then
        echo "auto (tcp; quic TLS missing)"
      else
        echo "auto (tcp; quic not enabled)"
      fi
      ;;
    quic) echo "quic" ;;
    tcp) echo "tcp" ;;
  esac
}

zenoh_auto_quic_enabled() {
  case "${ZENOH_AUTO_ENABLE_QUIC:-0}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

zenoh_quic_active() {
  [[ "$(zenoh_transport)" == "quic" ]] || { [[ "$(zenoh_transport)" == "auto" ]] && zenoh_auto_quic_enabled && zenoh_quic_ready_any; }
}

zenoh_tls_file_exists() {
  local value="$1"
  [[ -n "${value}" && -f "${value/#\~/${HOME}}" ]]
}

zenoh_quic_client_ready() {
  zenoh_tls_file_exists "${ZENOH_TLS_ROOT_CA:-}"
}

zenoh_quic_listener_ready() {
  zenoh_tls_file_exists "${ZENOH_TLS_LISTEN_KEY:-}" && zenoh_tls_file_exists "${ZENOH_TLS_LISTEN_CERT:-}"
}

zenoh_quic_ready_any() {
  zenoh_quic_client_ready || zenoh_quic_listener_ready
}

zenoh_quic_params() {
  local params="${ZENOH_QUIC_PARAMS:-multistream=1;mixed_rel=auto}"
  [[ -n "${params}" ]] && echo "?${params}"
}

zenoh_quic_endpoint() {
  local host="$1"
  local port="${ZENOH_PORT:-7447}"
  echo "quic/${host}:${port}$(zenoh_quic_params)"
}

zenoh_require_quic_client() {
  zenoh_quic_client_ready && return 0
  if [[ "$(zenoh_transport)" == "quic" ]]; then
    log_error "ZENOH_TRANSPORT=quic needs ZENOH_TLS_ROOT_CA."
    echo "Run './horus quic install-cert <hub-cert.pem>' on this machine, or use ZENOH_TRANSPORT=auto/tcp." >&2
    exit 2
  fi
  return 1
}

zenoh_require_quic_listener() {
  zenoh_quic_listener_ready && return 0
  if [[ "$(zenoh_transport)" == "quic" ]]; then
    log_error "ZENOH_TRANSPORT=quic needs ZENOH_TLS_LISTEN_KEY and ZENOH_TLS_LISTEN_CERT."
    echo "Run './horus quic setup-server' on the listening hub/machine, or use ZENOH_TRANSPORT=auto/tcp." >&2
    exit 2
  fi
  return 1
}

zenoh_connect_endpoints() {
  local -n output_ref="$1"
  local host="$2"
  local port="${ZENOH_PORT:-7447}"
  case "$(zenoh_transport)" in
    auto)
      if zenoh_auto_quic_enabled && zenoh_require_quic_client; then
        output_ref+=("$(zenoh_quic_endpoint "${host}")" "tcp/${host}:${port}")
      else
        output_ref+=("tcp/${host}:${port}")
      fi
      ;;
    quic)
      zenoh_require_quic_client
      output_ref+=("$(zenoh_quic_endpoint "${host}")")
      ;;
    tcp) output_ref+=("tcp/${host}:${port}") ;;
  esac
}

zenoh_listen_endpoints() {
  local -n output_ref="$1"
  local bind="${ZENOH_BIND:-0.0.0.0}"
  local port="${ZENOH_PORT:-7447}"
  case "$(zenoh_transport)" in
    auto)
      if zenoh_auto_quic_enabled && zenoh_require_quic_listener; then
        output_ref+=("$(zenoh_quic_endpoint "${bind}")" "tcp/${bind}:${port}")
      else
        output_ref+=("tcp/${bind}:${port}")
      fi
      ;;
    quic)
      zenoh_require_quic_listener
      output_ref+=("$(zenoh_quic_endpoint "${bind}")")
      ;;
    tcp) output_ref+=("tcp/${bind}:${port}") ;;
  esac
}

append_zenoh_connect_args() {
  local -n output_ref="$1"
  local target="$2"
  local endpoints=()
  local endpoint
  # Client mode needs an allOf endpoint group, supplied by link_profile.py.
  zenoh_priority_links && return 0
  zenoh_connect_endpoints endpoints "${target}"
  for endpoint in "${endpoints[@]}"; do
    output_ref+=(-e "${endpoint}")
  done
}

append_zenoh_listen_args() {
  local -n output_ref="$1"
  local endpoints=()
  local endpoint
  if zenoh_priority_links; then
    output_ref+=(-l "tcp/${ZENOH_BIND:-0.0.0.0}:${ZENOH_PORT:-7447}#so_sndbuf=${HORUS_ZENOH_TCP_SEND_BUFFER:-65536}")
    return 0
  fi
  zenoh_listen_endpoints endpoints
  for endpoint in "${endpoints[@]}"; do
    output_ref+=(-l "${endpoint}")
  done
}

join_by_comma() {
  local IFS=", "
  echo "$*"
}

zenoh_connect_summary() {
  local target="$1"
  local endpoints=()
  zenoh_connect_endpoints endpoints "${target}"
  join_by_comma "${endpoints[@]}"
}

zenoh_listen_summary() {
  local endpoints=()
  zenoh_listen_endpoints endpoints
  join_by_comma "${endpoints[@]}"
}

webrtc_control_enabled() {
  local enabled="${WEBRTC_CONTROL_ENABLED:-${WEBRTC_ENABLE_CONTROL:-0}}"
  case "${enabled,,}" in
    1|true|yes|on) echo "1" ;;
    *) echo "0" ;;
  esac
}

zenoh_docker_cmd() {
  if [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" ]]; then
    printf '%q ' sudo -n docker
  else
    printf '%q ' docker
  fi
}

zenoh_docker_name() {
  local role="$1"
  local room="${HORUS_ROOM:-default}"
  room="${room//[^A-Za-z0-9_.-]/_}"
  echo "horus-zenoh-${role}-${room}"
}

zenoh_uses_docker() {
  [[ "${ZENOH_BRIDGE_RUNTIME:-binary}" == "docker" ]]
}

append_unique_mount_dir() {
  local -n output_ref="$1"
  local file="$2"
  local dir mount
  [[ -n "${file}" ]] || return 0
  file="${file/#\~/${HOME}}"
  [[ -e "${file}" ]] || return 0
  dir="$(dirname "${file}")"
  mount="${dir}:${dir}:ro"
  local existing
  for existing in "${output_ref[@]}"; do
    [[ "${existing}" == "${mount}" ]] && return 0
  done
  output_ref+=("${mount}")
}

zenoh_docker_tls_mount_args() {
  local -n output_ref="$1"
  local mounts=()
  local mount
  append_unique_mount_dir mounts "${ZENOH_TLS_ROOT_CA:-}"
  append_unique_mount_dir mounts "${ZENOH_TLS_LISTEN_KEY:-}"
  append_unique_mount_dir mounts "${ZENOH_TLS_LISTEN_CERT:-}"
  append_unique_mount_dir mounts "${ZENOH_TLS_CONNECT_KEY:-}"
  append_unique_mount_dir mounts "${ZENOH_TLS_CONNECT_CERT:-}"
  for mount in "${mounts[@]}"; do
    output_ref+=(-v "${mount}")
  done
}

check_zenoh_docker_access() {
  local docker_cmd=(docker)
  if [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" ]]; then
    docker_cmd=(sudo -n docker)
  fi

  if ! timeout 10 "${docker_cmd[@]}" ps >/dev/null 2>&1; then
    if [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" && -t 0 ]]; then
      echo "Zenoh Docker fallback needs sudo; refreshing sudo credentials."
      sudo -v
      timeout 30 sudo docker ps >/dev/null 2>&1 && return
    fi
    if [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" ]]; then
      echo "Zenoh Docker fallback needs sudo Docker access. Run 'sudo -v' before launch, or add this user to the docker group and log out/in." >&2
    else
      echo "Zenoh Docker fallback is configured, but Docker is not available to this user." >&2
    fi
    exit 1
  fi
}

zenoh_connect_target() {
  local role="$1"
  local topology="${HORUS_TOPOLOGY:-hub}"
  case "${role}:${topology}" in
    robot:hub|machine:hub|teammate:hub)
      required_value HORUS_CLOUD_IP "${HORUS_CLOUD_IP:-}"
      echo "${HORUS_CLOUD_IP}"
      ;;
    robot:direct|teammate:direct)
      required_value HORUS_MACHINE_IP "${HORUS_MACHINE_IP:-}"
      echo "${HORUS_MACHINE_IP}"
      ;;
    *)
      echo ""
      ;;
  esac
}

webrtc_signal_target() {
  if [[ -n "${HORUS_WEBRTC_SIGNAL_IP:-}" ]]; then
    echo "${HORUS_WEBRTC_SIGNAL_IP}"
  elif [[ "${HORUS_TOPOLOGY:-hub}" == "direct" ]]; then
    if [[ "${HORUS_ROLE:-}" == "machine" ]]; then
      echo "${HORUS_MACHINE_IP:-0.0.0.0}"
    else
      required_value HORUS_MACHINE_IP "${HORUS_MACHINE_IP:-}"
      echo "${HORUS_MACHINE_IP}"
    fi
  else
    required_value HORUS_CLOUD_IP "${HORUS_CLOUD_IP:-}"
    echo "${HORUS_CLOUD_IP}"
  fi
}

webrtc_signal_scheme() {
  if [[ "${HORUS_TOPOLOGY:-hub}" == "hub" && "${HORUS_WEBRTC_SIGNAL_TLS:-0}" == "1" ]]; then
    echo "wss"
  else
    echo "ws"
  fi
}

webrtc_signal_url() {
  local target="$1"
  echo "$(webrtc_signal_scheme)://${target}:${WEBRTC_SIGNAL_PORT:-8765}"
}

ensure_webrtc_media_supported() {
  if [[ "${WEBRTC_MEDIA_MODE:-h264}" == "jpeg" && "${HORUS_TOPOLOGY:-hub}" == "hub" ]]; then
    echo "WEBRTC_MEDIA_MODE=jpeg is the legacy direct-mode fallback and does not use the cloud signaling relay." >&2
    echo "Use WEBRTC_MEDIA_MODE=h264 for hub deployments, or HORUS_TOPOLOGY=direct for JPEG fallback tests." >&2
    exit 2
  fi
}

zenoh_enabled() {
  [[ "${HORUS_ZENOH_ENABLED:-1}" != "0" ]]
}

warn_runtime_config() {
  local duration="${WEBRTC_DURATION:-0}"
  local duration_int="${duration%%.*}"
  if [[ "${duration_int}" =~ ^[0-9]+$ && "${duration_int}" -gt 0 && "${duration_int}" -lt 300 ]]; then
    echo "Warning: WEBRTC_DURATION=${duration} starts a finite test session. Use 0 for normal runs." >&2
  fi
}

tcp_probe() {
  local host="$1"
  local port="$2"
  if timeout 4 bash -c ":</dev/tcp/${host}/${port}" >/dev/null 2>&1; then
    echo -e "${FG_GREEN}open${RESET} (${host}:${port})"
    return 0
  fi
  echo -e "${FG_RED}closed${RESET} (${host}:${port})"
  return 1
}

turn_enabled() {
  [[ "${HORUS_CLOUD_RUN_TURN:-0}" == "1" ]]
}

turn_service_name() {
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files coturn.service >/dev/null 2>&1; then
    echo "coturn"
  elif command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files turnserver.service >/dev/null 2>&1; then
    echo "turnserver"
  else
    echo "coturn"
  fi
}

run_root_available() {
  [[ "$(id -u)" -eq 0 ]] || sudo -n true >/dev/null 2>&1
}

run_root_cmd() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  else
    sudo -n "$@"
  fi
}

turn_running() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --quiet is-active "$(turn_service_name)" >/dev/null 2>&1 && return 0
  fi
  pgrep -x turnserver >/dev/null 2>&1
}

start_turn_relay() {
  turn_enabled || return 0
  if ! command -v turnserver >/dev/null 2>&1; then
    log_error "TURN is enabled but coturn is not installed. Run ./horus bootstrap cloud."
    return 1
  fi
  if turn_running; then
    log_success "TURN relay is already running; preserving the shared system service."
    return
  fi
  if run_root_available; then
    bash "${ROOT}/scripts/setup_turn.sh"
    return
  fi
  log_error "TURN is enabled but is not running and cannot be started without sudo. Run ./horus bootstrap cloud on the hub."
  return 1
}

status_turn() {
  if ! turn_enabled; then
    printf "  %-10s %b\n" "turn" "${FG_MUTED}disabled${RESET}"
    return
  fi
  local service
  service="$(turn_service_name)"
  if turn_running; then
    printf "  %-10s %b\n" "turn" "${FG_GREEN}running${RESET} ${FG_MUTED}${service}, udp/tcp ${TURN_PORT:-3478}, relay ${TURN_MIN_PORT:-49152}-${TURN_MAX_PORT:-65535}${RESET}"
  else
    printf "  %-10s %b\n" "turn" "${FG_RED}stopped${RESET} ${FG_MUTED}${service}${RESET}"
  fi
}

doctor() {
  local role="$1"
  export HORUS_ROLE="${role}"
  local target=""

  echo -e "\n${BOLD}${FG_CYAN}Connectivity doctor${RESET}"
  echo -e "  role       ${role}"
  echo -e "  topology   ${HORUS_TOPOLOGY:-hub}"
  echo -e "  room       ${HORUS_ROOM:-default}"
  warn_runtime_config
  echo ""
  run_dds_preflight "${role}" doctor || true
  echo ""

  case "${role}:${HORUS_TOPOLOGY:-hub}" in
    robot:direct|teammate:direct)
      target="$(zenoh_connect_target "${role}")"
      echo -e "  transport  ${FG_CYAN}$(zenoh_transport_label)${RESET}"
      echo -e "  target     ${target}"
      echo -en "  zenoh      "
      tcp_probe "${target}" "${ZENOH_PORT:-7447}" || true
      if zenoh_quic_active; then
        echo -e "  zenoh udp  ${FG_MUTED}udp/${target}:${ZENOH_PORT:-7447} must be reachable for QUIC${RESET}"
      fi
      if [[ "${role}" != "teammate" ]]; then
        echo -en "  signaling  "
        tcp_probe "$(webrtc_signal_target)" "${WEBRTC_SIGNAL_PORT:-8765}" || true
      fi
      ;;
    machine:direct)
      echo -e "  mode       listening for direct robot connections"
      echo -e "  transport  ${FG_CYAN}$(zenoh_transport_label)${RESET}"
      echo -e "  addresses"
      local ips
      ips=$(hostname -I 2>/dev/null || true)
      for ip in ${ips}; do
        if [[ -n "${ip}" ]]; then
          echo -e "    ${ip}"
        fi
      done
      echo -e "  expected   $(zenoh_listen_summary), tcp/0.0.0.0:${WEBRTC_SIGNAL_PORT:-8765}"
      local active_listeners
      active_listeners=$(ss -ltnp 2>/dev/null | grep -E ":(${ZENOH_PORT:-7447}|${WEBRTC_SIGNAL_PORT:-8765})" || true)
      if [[ -n "${active_listeners}" ]]; then
        echo -e "  listeners"
        while read -r line; do
          echo -e "    ${FG_GREEN}running${RESET} ${line}"
        done <<< "${active_listeners}"
      else
        echo -e "  listeners  ${FG_MUTED}none detected yet${RESET}"
      fi
      ;;
    robot:hub|machine:hub|teammate:hub)
      target="$(zenoh_connect_target "${role}")"
      echo -e "  transport  ${FG_CYAN}$(zenoh_transport_label)${RESET}"
      echo -e "  cloud      ${target}"
      echo -en "  zenoh      "
      tcp_probe "${target}" "${ZENOH_PORT:-7447}" || true
      if zenoh_quic_active; then
        echo -e "  zenoh udp  ${FG_MUTED}udp/${target}:${ZENOH_PORT:-7447} must be reachable for QUIC${RESET}"
      fi
      if [[ "${role}" != "teammate" ]]; then
        echo -en "  signaling  "
        tcp_probe "$(webrtc_signal_target)" "${WEBRTC_SIGNAL_PORT:-8765}" || true
      fi
      if [[ "${role}" != "teammate" && ( "${WEBRTC_ICE_SERVERS:-}" == *"turn:"* || "${WEBRTC_ICE_SERVERS:-}" == *"turns:"* ) ]]; then
        echo -e "  turn       ${FG_GREEN}configured${RESET} ${FG_MUTED}${WEBRTC_ICE_SERVERS#*,}${RESET}"
      fi
      ;;
    cloud:*)
      echo -e "  mode       listening for robot and machine connections"
      echo -e "  transport  ${FG_CYAN}$(zenoh_transport_label)${RESET}"
      local active_listeners
      active_listeners=$(ss -ltunp 2>/dev/null | grep -E ":(${ZENOH_PORT:-7447}|${WEBRTC_SIGNAL_PORT:-8765}|${TURN_PORT:-3478})" || true)
      if [[ -n "${active_listeners}" ]]; then
        echo -e "  listeners"
        while read -r line; do
          echo -e "    ${FG_GREEN}running${RESET} ${line}"
        done <<< "${active_listeners}"
      else
        echo -e "  listeners  ${FG_MUTED}none detected${RESET}"
      fi
      if turn_enabled; then
        echo -e "  turn       ${FG_GREEN}enabled${RESET} udp/tcp ${TURN_PORT:-3478}, relay udp ${TURN_MIN_PORT:-49152}-${TURN_MAX_PORT:-65535}"
      fi
      ;;
  esac
  if [[ "${role}" == "teammate" ]]; then
    local hololens_host="${FIELD_TEAMMATE_HOLOLENS_HOST:-${HOLOLENS_HOST:-}}"
    echo -e "  teammate  ${FIELD_TEAMMATE_NAME:-${HORUS_ROOM:-field_teammate_1}}"
    if [[ -z "${hololens_host}" ]]; then
      echo -e "  hololens  ${FG_YELLOW}not configured${RESET} ${FG_MUTED}set FIELD_TEAMMATE_HOLOLENS_HOST${RESET}"
    else
      echo -e "  hololens  ${hololens_host}"
      echo -en "  pv        "
      tcp_probe "${hololens_host}" "${FIELD_TEAMMATE_PV_PORT:-3810}" || true
      echo -en "  pose      "
      tcp_probe "${hololens_host}" "${FIELD_TEAMMATE_SPATIAL_INPUT_PORT:-3814}" || true
      echo -en "  umq       "
      tcp_probe "${hololens_host}" "${FIELD_TEAMMATE_UMQ_PORT:-3816}" || true
    fi
  fi
  echo ""
}

start_bg() {
  local name="$1"
  shift
  local log="${RUN_DIR}/${name}.log"
  local pid="${RUN_DIR}/${name}.pid"
  local restart_args=(--retry-startup-errors)
  if [[ "${name}" != webrtc* || "${WEBRTC_DURATION:-0}" =~ ^0+([.]0+)?$ ]]; then
    restart_args+=(--restart-on-clean-exit)
  fi

  if service_pid_owned "${name}"; then
    log_warn "Service ${BOLD}${name}${RESET} is already running (PID $(cat "${pid}"))."
    return
  fi
  rm -f -- "${pid}" "${pid}.start"

  rotate_log "${name}" "${log}"
  rm -f -- "${RUN_DIR}/${name}.service.json" "${RUN_DIR}/${name}.media.json"
  log_run "Launching ${BOLD}${name}${RESET}... (log: ${FG_MUTED}${log}${RESET})"
  (
    [[ -z "${INSTANCE_LOCK:-}" ]] || exec {INSTANCE_LOCK}>&-
    exec nohup env "HORUS_MEDIA_STATUS_FILE=${RUN_DIR}/${name}.media.json" "HORUS_MEDIA_SUPERVISED=1" \
      python3 "${ROOT}/scripts/service_runner.py" --log "${log}" \
      --state "${RUN_DIR}/${name}.service.json" --max-restarts "${HORUS_SERVICE_MAX_RESTARTS:-5}" \
      --restart-window "${HORUS_SERVICE_RESTART_WINDOW:-300}" "${restart_args[@]}" -- "$@"
  ) >"${RUN_DIR}/${name}.supervisor.log" 2>&1 < /dev/null &
  local child_pid="$!"
  echo "${child_pid}" > "${pid}"
  process_start_time "${child_pid}" > "${pid}.start" || true
  NEW_SERVICES+=("${name}")
  if [[ -n "${HORUS_LAUNCH_RECEIPT:-}" ]]; then
    printf '%s\t%s\t%s\n' "${name}" "${child_pid}" "$(<"${pid}.start")" >> "${HORUS_LAUNCH_RECEIPT}"
  fi
  local attempt readiness="" ready=0 port=0
  case "${name}" in
    signal) port="${WEBRTC_SIGNAL_PORT:-8765}" ;;
    metrics) port="${HORUS_METRICS_PORT:-9418}" ;;
    zenoh|zenoh-sensing|zenoh-bulk)
      if [[ "${HORUS_ROLE:-}" == "cloud" || "${HORUS_ROLE:-}:${HORUS_TOPOLOGY:-hub}" == "machine:direct" ]]; then
        [[ "$(zenoh_transport)" == "quic" ]] || port="${ZENOH_PORT:-7447}"
        [[ "${name}" != "zenoh-sensing" ]] || port="$((port+1))"
        [[ "${name}" != "zenoh-bulk" ]] || port="$((port+2))"
      fi ;;
  esac
  for ((attempt=0; attempt<${HORUS_SERVICE_START_ATTEMPTS:-100}; attempt++)); do
    service_pid_owned "${name}" || break
    if readiness="$(python3 "${ROOT}/scripts/service_readiness.py" --run-dir "${RUN_DIR}" --name "${name}" --port "${port}")"; then
      ready=1
      break
    fi
    sleep .1
  done
  if [[ "${ready}" == "1" ]] && service_pid_owned "${name}"; then
    log_success "Service ${BOLD}${name}${RESET} initialized ${FG_MUTED}(${readiness}; supervisor PID ${child_pid})${RESET}"
  else
    log_error "Service ${BOLD}${name}${RESET} failed to start. Check: tail -n 20 ${log}"
    stop_owned_service "${name}"
    rm -f -- "${pid}" "${pid}.start"
    return 1
  fi
}

stop_owned_service() {
  local name="$1" attempts
  if service_pid_owned "${name}"; then
    kill "$(<"${RUN_DIR}/${name}.pid")" || true
    for ((attempts=0; attempts<100; attempts++)); do
      service_pid_owned "${name}" || break
      sleep 0.1
    done
    if service_pid_owned "${name}"; then
      python3 "${ROOT}/scripts/service_runner.py" --state "${RUN_DIR}/${name}.service.json" \
        --stop-owned-group --owner-pid "$(<"${RUN_DIR}/${name}.pid")" \
        --owner-start "$(process_start_time "$(<"${RUN_DIR}/${name}.pid")")" || true
      kill -KILL "$(<"${RUN_DIR}/${name}.pid")" || true
    fi
  fi
  rm -f -- "${RUN_DIR}/${name}.pid" "${RUN_DIR}/${name}.pid.start"
}

rollback_launch() {
  local result="$?" index
  if [[ "${result}" != "0" ]]; then
    log_error "Launch failed; stopping only services created by this launch."
    for ((index=${#NEW_SERVICES[@]}-1; index>=0; index--)); do
      stop_owned_service "${NEW_SERVICES[$index]}"
    done
  fi
}

lock_instance() {
  exec {INSTANCE_LOCK}>"${RUN_DIR}/launcher.lock"
  flock -w 20 "${INSTANCE_LOCK}" || { log_error "Another launch/stop is in progress."; return 1; }
}

preflight_media() {
  local role="$1" rows candidate chosen="" need_ros=() profile=()
  if [[ "${role}" == "cloud" ]]; then
    [[ "${HORUS_CLOUD_RUN_SIGNALING:-1}" == "1" ]] || return 0
  else
    rows="$(webrtc_stream_rows "${role}")" || return 1
    webrtc_session_row "${role}" >/dev/null || return 1
    [[ -n "${rows}" ]] || return 0
    python3 "${ROOT}/scripts/webrtc_streams.py" capacity-json --root "${ROOT}" --role "${role}" >"${RUN_DIR}/media_capacity.json" || return 1
    source_ros_required
    need_ros=(--need-ros)
    if [[ "${WEBRTC_MEDIA_MODE:-h264}" == "h264" ]]; then
      profile=(--root "${ROOT}" --profile "${RUN_DIR}/webrtc_profile.env")
    fi
    if [[ -n "${HORUS_WEBRTC_ADDITIONAL_ROOMS:-}" && "${HORUS_TOPOLOGY:-hub}" != "hub" ]]; then
      log_error "Additional operator rooms require hub topology."
      return 1
    fi
  fi
  if [[ -n "${HORUS_WEBRTC_PYTHON:-}" ]]; then
    chosen="${HORUS_WEBRTC_PYTHON}"
  else
    for candidate in "${WEBRTC_VENV:-${ROOT}/.venv-webrtc}/bin/python" /usr/bin/python3 python3; do
      command -v "${candidate}" >/dev/null || continue
      if "${candidate}" "${ROOT}/scripts/media_runtime.py" --role "${role}" \
        --mode "${WEBRTC_MEDIA_MODE:-h264}" "${need_ros[@]}" >/dev/null 2>&1; then
        chosen="${candidate}"
        break
      fi
    done
  fi
  [[ -n "${chosen}" ]] || { log_error "No complete media Python runtime. Run ./horus bootstrap ${role}."; return 1; }
  "${chosen}" "${ROOT}/scripts/media_runtime.py" --role "${role}" \
    --mode "${WEBRTC_MEDIA_MODE:-h264}" "${need_ros[@]}" "${profile[@]}" || return 1
  export HORUS_WEBRTC_PYTHON="${chosen}"
}

process_start_time() {
  local pid="$1" stat
  local fields=()
  [[ "${pid}" =~ ^[0-9]+$ && -r "/proc/${pid}/stat" ]] || return 1
  stat="$(<"/proc/${pid}/stat")"
  read -r -a fields <<< "${stat##*) }"
  [[ "${fields[0]:-}" != "Z" && -n "${fields[19]:-}" ]] || return 1
  printf '%s\n' "${fields[19]}"
}

service_pid_owned() {
  local name="$1" file pid recorded current
  file="${RUN_DIR}/${name}.pid"
  [[ -f "${file}" ]] || return 1
  pid="$(<"${file}")"
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "${pid}" >/dev/null 2>&1 || return 1
  if [[ -f "${file}.start" ]]; then
    recorded="$(<"${file}.start")"
    current="$(process_start_time "${pid}")" || return 1
    [[ -n "${recorded}" && "${recorded}" == "${current}" ]]
  else
    project_pid_matches "${pid}"
  fi
}

rotate_log() {
  local name="$1"
  local log="$2"
  local keep="${HORUS_LOG_KEEP:-10}"
  local archive_dir="${RUN_DIR}/logs"
  local timestamp
  [[ -s "${log}" ]] || return 0
  mkdir -p "${archive_dir}"
  timestamp="$(date '+%Y%m%d-%H%M%S')"
  mv "${log}" "${archive_dir}/${name}-${timestamp}.log"
  if [[ "${keep}" =~ ^[0-9]+$ && "${keep}" -gt 0 ]]; then
    mapfile -t old_logs < <(find "${archive_dir}" -maxdepth 1 -type f -name "${name}-*.log" | sort)
    local remove_count=$(( ${#old_logs[@]} - keep ))
    local index
    for (( index=0; index<remove_count; index++ )); do
      rm -f -- "${old_logs[$index]}"
    done
  fi
}

project_pid_matches() {
  local pid="$1"
  local cwd cmdline
  [[ "${pid}" == "$$" ]] && return 1
  cwd="$(readlink -f "/proc/${pid}/cwd" 2>/dev/null || true)"
  cmdline="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null || true)"
  [[ "${cwd}" == "${ROOT}" || "${cmdline}" == *"${ROOT}/"* ]]
}

get_pid_stats() {
  local name="$1"
  local pid_file="${RUN_DIR}/${name}.pid"
  if [[ -f "${pid_file}" ]]; then
    local p_id
    p_id=$(cat "${pid_file}" 2>/dev/null || echo "")
    if service_pid_owned "${name}"; then
      local stats
      stats=$(ps -p "${p_id}" -o %cpu,%mem,etimes --no-headers 2>/dev/null || echo "")
      if [[ -n "${stats}" ]]; then
        local cpu mem etimes uptime_str
        cpu=$(echo "${stats}" | awk '{print $1}')
        mem=$(echo "${stats}" | awk '{print $2}')
        etimes=$(echo "${stats}" | awk '{print $3}')

        if [[ "${etimes}" -lt 60 ]]; then
          uptime_str="${etimes}s"
        elif [[ "${etimes}" -lt 3600 ]]; then
          uptime_str="$((etimes / 60))m$((etimes % 60))s"
        else
          uptime_str="$((etimes / 3600))h$(((etimes % 3600) / 60))m"
        fi
        echo -ne " ${FG_MUTED}(CPU: ${cpu}%, MEM: ${mem}%, UPTIME: ${uptime_str})${RESET}"
      fi
    fi
  fi
}

status_one() {
  local name="$1"
  local pid="${RUN_DIR}/${name}.pid"
  if service_pid_owned "${name}"; then
    local p_id
    p_id=$(cat "${pid}")
    printf "  %-10s %b\n" "${name}" "${FG_GREEN}running${RESET} ${FG_MUTED}PID ${p_id}${RESET}$(get_pid_stats "${name}")"
  else
    printf "  %-10s %b\n" "${name}" "${FG_MUTED}stopped${RESET}"
  fi
}

status_webrtc_streams() {
  local role="${HORUS_ROLE:-robot}"
  if [[ -n "${HORUS_MEDIA_RELAY_CONFIG:-}" ]]; then
    status_one media-relay
  fi
  if [[ "${HORUS_SOURCE_MEDIA_ENABLED:-0}" == "1" ]]; then
    status_one source-media
    printf '  source video is negotiated directly with HORUS; process state is not frame-delivery proof\n'
  fi
  local rows=()
  local row service rest stream_text session_text session_mode session_room session_id
  local room extra_room existing_room duplicate room_index
  local rooms=() configured_rooms=()
  if { [[ "${role}" != "robot" && "${role}" != "machine" ]] || [[ "${WEBRTC_MEDIA_MODE:-h264}" != "h264" ]]; }; then
    status_one webrtc
    return
  fi
  stream_text="$(webrtc_stream_rows "${role}")" || return 1
  [[ -n "${stream_text}" ]] && mapfile -t rows <<< "${stream_text}"
  if [[ "${#rows[@]}" -eq 0 ]]; then
    printf "  %-10s %b\n" "webrtc" "${FG_MUTED}no enabled camera streams${RESET}"
    return
  fi
  session_text="$(webrtc_session_row "${role}")" || return 1
  IFS=$'\t' read -r session_mode session_room session_id <<< "${session_text}"
  if [[ "${session_mode}" == "bundled" ]]; then
    status_one webrtc
    if [[ "${role}" == "robot" && -n "${HORUS_WEBRTC_ADDITIONAL_ROOMS:-}" ]]; then
      rooms=("${session_room}")
      IFS=',' read -r -a configured_rooms <<< "${HORUS_WEBRTC_ADDITIONAL_ROOMS}"
      for extra_room in "${configured_rooms[@]}"; do
        extra_room="$(trim_spaces "${extra_room}")"
        [[ -n "${extra_room}" ]] || continue
        duplicate=0
        for existing_room in "${rooms[@]}"; do
          [[ "${extra_room}" == "${existing_room}" ]] && duplicate=1
        done
        [[ "${duplicate}" == "1" ]] || rooms+=("${extra_room}")
      done
      for room_index in "${!rooms[@]}"; do
        [[ "${room_index}" == "0" ]] || status_one "webrtc-operator-${room_index}"
      done
    fi
    return
  fi
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r service rest <<< "${row}"
    status_one "${service}"
  done
}

status_zenoh() {
  if [[ "${ZENOH_BRIDGE_RUNTIME:-binary}" == "docker" ]]; then
    local docker_cmd=(docker)
    local status
    [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" ]] && docker_cmd=(sudo -n docker)
    status="$(timeout 10 "${docker_cmd[@]}" ps --filter "name=$(zenoh_docker_name "${HORUS_ROLE:-robot}")" --format '{{.Status}}' 2>/dev/null || true)"
    if [[ -n "${status}" ]]; then
      printf "  %-10s %b\n" "zenoh" "${FG_GREEN}running${RESET} ${FG_MUTED}Docker $(zenoh_docker_name "${HORUS_ROLE:-robot}") - ${status}${RESET}"
    else
      printf "  %-10s %b\n" "zenoh" "${FG_MUTED}stopped${RESET}"
    fi
    return
  fi
  status_one zenoh
}

open_monitor_after_launch() {
  local no_monitor="$1"
  if [[ "${no_monitor}" == "1" || "${HORUS_LAUNCH_MONITOR:-1}" == "0" || ! -t 1 ]]; then
    return
  fi
  local monitor_pid="${RUN_DIR}/monitor.pid"
  if [[ -f "${monitor_pid}" ]]; then
    local p_id
    p_id="$(cat "${monitor_pid}" 2>/dev/null || true)"
    if [[ -n "${p_id}" ]] && kill -0 "${p_id}" >/dev/null 2>&1; then
      log_info "Live console already open ${FG_MUTED}(PID ${p_id})${RESET}; services are running in the background."
      return
    fi
    rm -f "${monitor_pid}"
  fi
  python3 "${ROOT}/scripts/horus_monitor.py" --root "${ROOT}" --env "${ENV_FILE}"
}

zenoh_session_mode() {
  if [[ -z "${1:-}" ]]; then
    printf '%s\n' router
