        [[ "${duplicate}" == "1" ]] || media_rooms+=("${extra_room}")
      done
    fi
    for room_index in "${!media_rooms[@]}"; do
      service_name=webrtc
      [[ "${room_index}" == "0" ]] || service_name="webrtc-operator-${room_index}"
      start_bg "${service_name}" env "HORUS_WEBRTC_SESSION_ROOM=${media_rooms[$room_index]}" "${py}" "${ROOT}/scripts/gst_webrtc_h264_robot.py" \
      --root "${ROOT}" \
      --streams-config "${HORUS_STREAMS_CONFIG:-config/webrtc_streams.json}" \
      --signaling-url "$(webrtc_signal_url "${target}")" \
      --room "${media_rooms[$room_index]}" \
