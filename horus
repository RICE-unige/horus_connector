launch_zenoh_session_lanes() {
  local role="$1" target="${2:-}" bridge="${ZENOH_BRIDGE_BINARY:-${ROOT}/zenoh-bridge-ros2dds}"
  local base uri bulk_rate name class rate budget
  local namespace_args=()
  local dscp_args=()
  ! zenoh_uses_docker && [[ "$(zenoh_transport)" == "tcp" ]] || {
    log_error "Independent sessions currently require the native TCP bridge on both endpoints."; return 1;
  }
  if service_pid_owned zenoh && [[ ! -f "${RUN_DIR}/session-lanes/realtime.json" ]]; then
    log_error "Stop the existing single-session connector before enabling independent sessions."; return 1;
  fi
  if [[ "${role}" == "cloud" ]]; then
    source_ros || true
  else
    source_ros_required
  fi
  bulk_rate="$(zenoh_bulk_rate)" || return 1
  base="$(zenoh_routing_config)" || return 1
  [[ -z "${HORUS_ZENOH_SESSION_DSCP:-}" ]] || dscp_args=(--dscp "${HORUS_ZENOH_SESSION_DSCP}")
  "$(python_bin)" "${ROOT}/scripts/session_lanes.py" --base "${base}" --output "${RUN_DIR}/session-lanes" \
    --binary "${bridge}" --target "${target}" --bind "${ZENOH_BIND:-0.0.0.0}" --port "${ZENOH_PORT:-7447}" \
    --send-buffer "${HORUS_ZENOH_TCP_SEND_BUFFER:-65536}" "${dscp_args[@]}" || return 1
  uri="$(dds_connector_uri "${role}")"
  [[ -z "${ZENOH_NAMESPACE:-}" ]] || namespace_args=(-n "${ZENOH_NAMESPACE}")
  for class in realtime sensing bulk; do
    name=zenoh
    [[ "${class}" == "realtime" ]] || name="zenoh-${class}"
    rate=0; budget=""
    if [[ "${class}" == "bulk" ]]; then
      rate="${bulk_rate}"; budget="${HORUS_ZENOH_BULK_BUDGET_FILE:-}"
    fi
    start_bg "${name}" env "CYCLONEDDS_URI=${uri}" "HORUS_ZENOH_BULK_BYTES_PER_SECOND=${rate}" \
      "HORUS_ZENOH_BULK_BUDGET_FILE=${budget}" "${bridge}" -c "${RUN_DIR}/session-lanes/${class}.json" \
      "${namespace_args[@]}" --no-multicast-scouting "$(zenoh_session_mode "${target}")" || return 1
  done
}

launch_zenoh_client() {
  if [[ "${HORUS_ZENOH_SESSION_ISOLATION:-0}" == "1" ]]; then
    launch_zenoh_session_lanes "$1" "$2"; return;
  fi
  service_pid_owned zenoh && { log_info "Zenoh is already running."; return; }
  local role="$1"
  local target="$2"
  local bridge="${ZENOH_BRIDGE_BINARY:-${ROOT}/zenoh-bridge-ros2dds}"
  local config
  local dds_uri
  local docker_cmd=(docker)
  local docker_dds_args=()
  local docker_mount_args=()
  local docker_env_args=()
  local namespace_args=()
  local zenoh_args=()
  local endpoint_args=()
  local bulk_rate
  local transport_mode=client
  zenoh_priority_links && transport_mode=peer
  bulk_rate="$(zenoh_bulk_rate)" || return 1
  append_zenoh_connect_args endpoint_args "${target}"
  if zenoh_uses_docker; then
    [[ "${bulk_rate}" == "0" ]] || { log_error "Bulk byte pacing requires the native priority bridge build."; return 1; }
    check_zenoh_docker_access
    [[ "${ZENOH_BRIDGE_DOCKER_SUDO:-0}" == "1" ]] && docker_cmd=(sudo -n docker)
    [[ -n "${ZENOH_NAMESPACE:-}" ]] && namespace_args=(-n "${ZENOH_NAMESPACE}")
    build_zenoh_common_args zenoh_args
    config="${zenoh_args[1]}"
    [[ -f "${config}" ]] || { echo "Missing Zenoh config: ${config}" >&2; exit 1; }
    dds_connector_docker_args docker_dds_args "${role}"
    dds_docker_env_args docker_env_args
    if zenoh_quic_active; then
      config="$(zenoh_runtime_config_path "${config}")"
      zenoh_docker_tls_mount_args docker_mount_args
    fi
    start_bg zenoh "${docker_cmd[@]}" run --rm \
      --name "$(zenoh_docker_name "${role}")" \
      --label "horus.run_dir=${RUN_DIR}" \
      --network host \
      -e "ROS_DISTRO=${ROS_DISTRO:-jazzy}" \
      -e "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}" \
      "${docker_env_args[@]}" \
      "${docker_dds_args[@]}" \
      -v "${config}:/horus_zenoh.json5:ro" \
      "${docker_mount_args[@]}" \
      "${ZENOH_BRIDGE_IMAGE:-eclipse/zenoh-bridge-ros2dds:${ZENOH_VERSION:-$(python3 "${ROOT}/scripts/zenoh_release.py" --default-version)}}" \
      -c /horus_zenoh.json5 "${namespace_args[@]}" \
      --no-multicast-scouting "${endpoint_args[@]}" "${transport_mode}"
  else
    [[ -x "${bridge}" ]] || { echo "Missing Zenoh bridge. Run ./horus bootstrap ${role}." >&2; exit 1; }
    source_ros_required
    build_zenoh_common_args zenoh_args
    dds_uri="$(dds_connector_uri "${role}")"
    start_bg zenoh env "CYCLONEDDS_URI=${dds_uri}" "HORUS_ZENOH_BULK_BYTES_PER_SECOND=${bulk_rate}" "HORUS_ZENOH_BULK_BUDGET_FILE=${HORUS_ZENOH_BULK_BUDGET_FILE:-}" "${bridge}" "${zenoh_args[@]}" --no-multicast-scouting "${endpoint_args[@]}" "${transport_mode}"
  fi
}

