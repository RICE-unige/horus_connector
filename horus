decode_b64() {
  if [[ "$1" == "-" ]]; then
    return
  fi
  python3 -c 'import base64, sys; print(base64.b64decode(sys.argv[1]).decode("utf-8"), end="")' "$1"
}

webrtc_stream_rows() {
  local role="$1"
  python3 "${ROOT}/scripts/webrtc_streams.py" list --root "${ROOT}" --role "${role}"
}

webrtc_session_row() {
