native_media_plugin_path() {
  local path combined="${GST_PLUGIN_PATH:-}"
  for path in "${HORUS_MEDIA_GST_PLUGIN_DIR:-${ROOT}/.runtime/media-gcc/plugins}" \
      "${WEBRTC_VENV:-${ROOT}/.venv-webrtc}"/native/usr/lib/*/gstreamer-1.0; do
    [[ -d "${path}" ]] || continue
    combined="${path}${combined:+:${combined}}"
  done
  printf '%s' "${combined}"
}

native_media_configured() {
  [[ "${HORUS_SOURCE_MEDIA_ENABLED:-0}" == "1" ||
     ( -n "${HORUS_MEDIA_RELAY_CONFIG:-}" && "${HORUS_MEDIA_RELAY_ENGINE:-native}" == "native" ) ]]
}

print_native_media_summary() {
  local mode="${HORUS_OPERATOR_CONTROL_MODE:-local}"
