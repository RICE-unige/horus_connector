}

launch_source_media() {
  [[ "${HORUS_SOURCE_MEDIA_ENABLED:-0}" == "1" ]] || return 0
  local binary="${HORUS_SOURCE_MEDIA_BINARY:-}" bitrate="${HORUS_SOURCE_MEDIA_BITRATE_KBPS:-1500}"
  local fps="${HORUS_SOURCE_MEDIA_FPS:-15}"
  local media_env=(env "GST_PLUGIN_PATH=$(native_media_plugin_path)")
  if [[ -n "${HORUS_SOURCE_MEDIA_RMW:-}" ]]; then
    media_env+=("RMW_IMPLEMENTATION=${HORUS_SOURCE_MEDIA_RMW}")
  fi
  if [[ -n "${HORUS_SOURCE_MEDIA_FASTDDS_PROFILE:-}" ]]; then
    [[ -f "${HORUS_SOURCE_MEDIA_FASTDDS_PROFILE}" ]] || { log_error "Source media Fast DDS profile does not exist."; return 1; }
    media_env=(-u ROS_LOCALHOST_ONLY "${media_env[@]:1}"
      "ROS_AUTOMATIC_DISCOVERY_RANGE=SYSTEM_DEFAULT"
      "FASTDDS_DEFAULT_PROFILES_FILE=${HORUS_SOURCE_MEDIA_FASTDDS_PROFILE}"
      "FASTRTPS_DEFAULT_PROFILES_FILE=${HORUS_SOURCE_MEDIA_FASTDDS_PROFILE}")
    media_env=(env "${media_env[@]}")
  fi
  if [[ -z "${binary}" ]]; then
    binary="$(command -v horus_media_node || true)"
  fi
  [[ -x "${binary}" ]] || { log_error "Set HORUS_SOURCE_MEDIA_BINARY to the WebRTC-enabled horus_media_node executable."; return 1; }
  [[ "${bitrate}" =~ ^[0-9]+$ && "${fps}" =~ ^[0-9]+$ ]] || { log_error "Source media bitrate and FPS must be positive integers."; return 1; }
  ((bitrate >= 100 && bitrate <= 100000 && fps >= 1 && fps <= 60)) || { log_error "Source media bitrate or FPS is outside its supported range (100..100000 kbps, 1..60 FPS)."; return 1; }
  [[ "${HORUS_SOURCE_CONTROL_MODE:-local}" =~ ^(local|authority)$ ]] || { log_error "HORUS_SOURCE_CONTROL_MODE must be local or authority."; return 1; }
  start_bg source-media "${media_env[@]}" "${binary}" --ros-args \
    -p "control.mode:=${HORUS_SOURCE_CONTROL_MODE:-local}" \
    -p "webrtc.link_budget_kbps:=${HORUS_LINK_BUDGET_KBPS:-0}" \
    -p "webrtc.reserved_kbps:=${HORUS_LINK_RESERVED_KBPS:-512}" \
    -p "webrtc.bulk_floor_kbps:=${HORUS_LINK_BULK_FLOOR_KBPS:-256}" \
    -p "webrtc.bulk_budget_file:=${HORUS_ZENOH_BULK_BUDGET_FILE:-}" \
    -p "webrtc.share_encoders:=${HORUS_SOURCE_MEDIA_SHARE_ENCODERS:-true}" \
    -p "webrtc.client_signal_topic:=${HORUS_SOURCE_MEDIA_CLIENT_SIGNAL_TOPIC:-/horus/remote/webrtc/client_signal}" \
    -p "webrtc.server_signal_topic:=${HORUS_SOURCE_MEDIA_SERVER_SIGNAL_TOPIC:-/horus/remote/webrtc/server_signal}" \
    -p "webrtc.default_encoder:=${HORUS_SOURCE_MEDIA_ENCODER:-auto}" \
    -p "webrtc.default_bitrate_kbps:=${bitrate}" \
    -p "webrtc.default_framerate:=${fps}"
  log_info "Source-side video sender started; waiting for HORUS camera offers. No ROS camera payload is required across the WAN."
}

launch_media_relay() {
  [[ -n "${HORUS_MEDIA_RELAY_CONFIG:-}" ]] || return 0
  [[ -f "${HORUS_MEDIA_RELAY_CONFIG}" ]] || { log_error "HORUS_MEDIA_RELAY_CONFIG does not exist."; return 1; }
  source_ros_required
  local py dds_uri
  dds_uri="$(dds_connector_uri machine)"
  if [[ "${HORUS_MEDIA_RELAY_ENGINE:-native}" == "native" ]]; then
    local binary="${HORUS_MEDIA_RELAY_BINARY:-}" native_args=()
    [[ -n "${binary}" ]] || binary="$(command -v horus_unity_bridge_node || true)"
    [[ -x "${binary}" ]] || { log_error "Set HORUS_MEDIA_RELAY_BINARY to the WebRTC-enabled horus_unity_bridge_node."; return 1; }
    [[ "${HORUS_OPERATOR_CONTROL_MODE:-local}" =~ ^(local|proxy)$ ]] || { log_error "HORUS_OPERATOR_CONTROL_MODE must be local or proxy."; return 1; }
    if [[ -n "${HORUS_MEDIA_RELAY_BRIDGE_CONFIG:-}" ]]; then
      [[ -f "${HORUS_MEDIA_RELAY_BRIDGE_CONFIG}" ]] || { log_error "Native relay bridge configuration does not exist."; return 1; }
      native_args+=(--params-file "${HORUS_MEDIA_RELAY_BRIDGE_CONFIG}")
    fi
    start_bg media-relay env "CYCLONEDDS_URI=${dds_uri}" "GST_PLUGIN_PATH=$(native_media_plugin_path)" \
      "${binary}" --ros-args "${native_args[@]}" \
      -p webrtc.enabled:=true -p "webrtc.relay_config:=${HORUS_MEDIA_RELAY_CONFIG}" \
      -p "control.mode:=${HORUS_OPERATOR_CONTROL_MODE:-local}"
    log_info "Native HORUS bridge/packet relay started; SDK registrations reuse its connection. Video does not pass through ROS."
    return
  fi
  [[ "${HORUS_MEDIA_RELAY_ENGINE}" == "ros" ]] || { log_error "HORUS_MEDIA_RELAY_ENGINE must be native or ros."; return 1; }
  py="$(python_bin)"
  start_bg media-relay env "CYCLONEDDS_URI=${dds_uri}" "${py}" "${ROOT}/scripts/source_media_receiver.py" \
    --config "${HORUS_MEDIA_RELAY_CONFIG}"
}

