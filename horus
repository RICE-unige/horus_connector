  local row service stream_id room input_topic output_topic width height fps bitrate video_source source_pipeline_b64 frame_id qos source_pipeline
  local session_mode session_room session_id
  local stream_text session_text
  local media_rooms=() extra_room existing_room duplicate service_name room_index
  build_webrtc_latency_probe_args optional_args
  stream_text="$(webrtc_stream_rows robot)" || return 1
  if [[ -z "${stream_text}" ]]; then
    log_info "No enabled WebRTC camera streams; robot media was not started."
    return 0
  fi
  mapfile -t rows <<< "${stream_text}"
  session_text="$(webrtc_session_row robot)" || return 1
  IFS=$'\t' read -r session_mode session_room session_id <<< "${session_text}"
  if [[ -n "${HORUS_WEBRTC_ADDITIONAL_ROOMS:-}" && "${HORUS_TOPOLOGY:-hub}" != "hub" ]]; then
    log_error "Additional operator rooms require hub topology with a shared signaling relay."
    return 2
  fi
  if [[ "${session_mode}" == "bundled" ]]; then
    media_rooms=("${session_room}")
    if [[ -n "${HORUS_WEBRTC_ADDITIONAL_ROOMS:-}" ]]; then
      local configured_rooms=()
      IFS=',' read -r -a configured_rooms <<< "${HORUS_WEBRTC_ADDITIONAL_ROOMS}"
      for extra_room in "${configured_rooms[@]}"; do
        extra_room="$(trim_spaces "${extra_room}")"
        [[ -n "${extra_room}" ]] || continue
        duplicate=0
        for existing_room in "${media_rooms[@]}"; do
          [[ "${extra_room}" == "${existing_room}" ]] && duplicate=1
