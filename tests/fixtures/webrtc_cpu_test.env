# Explicit software codecs for disposable acceptance tests, not deployment tuning.
GST_H264_ENCODER_NAME='x264enc'
GST_H264_ENCODER_PREPROCESS='videoconvert ! video/x-raw,format=I420'
GST_H264_ENCODER_PROPS='bitrate=600 speed-preset=ultrafast tune=zerolatency key-int-max=15 bframes=0 byte-stream=true aud=false threads=1 sliced-threads=true'
GST_H264_DECODER_NAME='avdec_h264'
GST_H264_DECODER_PROPS=''
GST_H264_DECODER_POSTPROCESS=''
