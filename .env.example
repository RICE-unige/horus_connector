# Copy to .env and edit for your machine.

# role: robot, machine, teammate, or cloud
HORUS_ROLE=robot

# Pairing room for one robot-machine WebRTC session.
HORUS_ROOM=robot-a

# topology:
#   hub    robot(s) and machine(s) connect through one cloud relay/router
#   direct robot connects straight to machine over VPN/Tailscale/LAN
HORUS_TOPOLOGY=hub

# Shared cloud relay/router endpoint for hub mode.
HORUS_CLOUD_IP=

# Operator/local machine endpoint for direct mode.
HORUS_MACHINE_IP=

# Optional override for the WebRTC signaling receiver address.
# If empty, direct mode uses HORUS_MACHINE_IP and hub mode uses HORUS_CLOUD_IP.
HORUS_WEBRTC_SIGNAL_IP=

HORUS_SSH_ALIAS=cloud-host
REMOTE_DIR=~/horus_connector

# ROS. Match ROS_DISTRO to the ROS 2 distro installed on this machine
# (for example humble or jazzy).
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
# Optional. Set this when ROS 2 was installed/built outside /opt/ros/<distro>.
# Examples: /opt/ros/humble/setup.bash or ~/ros2_humble/install/setup.bash
ROS_SETUP_PATH=
ROS_LOCALHOST_ONLY=1
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_CMD_TOPIC=/cmd_vel
# DDS preflight records .run/dds_env.json and blocks launch on known DDS mismatches.
HORUS_SKIP_DDS_PREFLIGHT=0
# Optional. If your robot already has a working CycloneDDS XML profile,
# point the connector bridge at it instead of using HORUS' generated profile.
# Example: file:///home/user/cyclonedds.xml
CYCLONEDDS_URI=
# Optional CycloneDDS interface override for the connector bridge participant.
HORUS_DDS_INTERFACE=
HORUS_DDS_PREFLIGHT_TOPIC_TIMEOUT=5.0

# Optional namespace for multi-robot deployments, for example /robot_a.
ZENOH_NAMESPACE=

# Zenoh.
ZENOH_PORT=7447
ZENOH_VERSION=1.10.2
ZENOH_CONFIG=auto
# auto uses TCP unless QUIC is explicitly enabled after TLS cert/key setup.
ZENOH_TRANSPORT=auto
ZENOH_AUTO_ENABLE_QUIC=0
# QUIC endpoint options used when QUIC is active on Zenoh 1.9+.
ZENOH_QUIC_PARAMS=multistream=1;mixed_rel=auto
# Optional Zenoh TLS paths. Normal users should use:
#   cloud/listener: ./horus quic setup-server
#   robot/machine: ./horus quic install-cert <hub-cert.pem>
ZENOH_TLS_DIR=
ZENOH_TLS_ROOT_CA=
ZENOH_TLS_LISTEN_KEY=
ZENOH_TLS_LISTEN_CERT=
ZENOH_TLS_VERIFY_NAME=0
HORUS_ZENOH_ENABLED=1
# Set on both ends (and a hub, if used): independent urgent/sensor/bulk TCP links.
# Uses the same listening port; requires Zenoh 1.10.2 and TCP, with QoS retained.
HORUS_ZENOH_TRAFFIC_LANES=1
# Optional stronger isolation: independent TF/control, sensing, and bulk sessions.
# Both endpoints need the verified priority build and the same routing policy.
# Uses ZENOH_PORT through ZENOH_PORT+2. Stop services before changing this mode.
HORUS_ZENOH_SESSION_ISOLATION=0
# Optional six-bit DSCP codepoints for realtime,sensing,bulk (e.g. 46,18,8).
# Empty preserves existing sockets. Networks may strip or ignore these hints.
HORUS_ZENOH_SESSION_DSCP=
HORUS_ZENOH_BULK_BYTES_PER_SECOND=0
# Pending full-replacement mesh pages; no preallocation or geometry reduction.
HORUS_ZENOH_MESH_QUEUE_BYTES=134217728
# Optional native candidate; empty keeps the project-local release binary.
ZENOH_BRIDGE_BINARY=

# Optional direct source-to-HORUS video using the native ROS bridge encoder.
# Requires a WebRTC-enabled horus_media_node; does not start another TCP bridge.
HORUS_SOURCE_MEDIA_ENABLED=0
HORUS_SOURCE_MEDIA_BINARY=
HORUS_SOURCE_MEDIA_ENCODER=auto
HORUS_SOURCE_MEDIA_BITRATE_KBPS=1500
HORUS_SOURCE_MEDIA_FPS=15
HORUS_SOURCE_MEDIA_SHARE_ENCODERS=true
HORUS_LINK_BUDGET_KBPS=0
HORUS_LINK_RESERVED_KBPS=512
HORUS_LINK_BULK_FLOOR_KBPS=256
HORUS_ZENOH_BULK_BUDGET_FILE=
# Use authority only at the fleet edge; all operator proxies share its leases.
HORUS_SOURCE_CONTROL_MODE=local
# Normally inherit ROS middleware; override only for the camera source runtime.
HORUS_SOURCE_MEDIA_RMW=
HORUS_SOURCE_MEDIA_FASTDDS_PROFILE=
# Native starts the HORUS bridge with packet relay; ros keeps the legacy adapter.
HORUS_MEDIA_RELAY_CONFIG=
HORUS_MEDIA_RELAY_ENGINE=native
HORUS_MEDIA_RELAY_BINARY=
HORUS_MEDIA_RELAY_BRIDGE_CONFIG=
HORUS_OPERATOR_CONTROL_MODE=local
# Empty selects .runtime/media-gcc/plugins; existing NICE plugins are retained.
HORUS_MEDIA_GST_PLUGIN_DIR=
HORUS_SOURCE_MEDIA_CLIENT_SIGNAL_TOPIC=/horus/remote/webrtc/client_signal
HORUS_SOURCE_MEDIA_SERVER_SIGNAL_TOPIC=/horus/remote/webrtc/server_signal
HORUS_ZENOH_TCP_SEND_BUFFER=65536
# Optional explicit SDK/interface route additions; see docs/performance.md.
HORUS_ROUTES_CONFIG=
# Optional read-only sample probe at preflight (doctor also selects visible TF/odom).
HORUS_DDS_PROBE_TOPIC=
# compatible preserves ROS camera routes; configured honors per-stream webrtc_only.
HORUS_ZENOH_CAMERA_POLICY=compatible

# WebRTC.
# h264 is the supported hub/direct media path. jpeg is a legacy direct-mode fallback only.
WEBRTC_MEDIA_MODE=h264
HORUS_ALLOW_LEGACY_JPEG=0
WEBRTC_SIGNAL_PORT=8765
HORUS_WEBRTC_SIGNAL_TLS=0
HORUS_WEBRTC_SIGNAL_TLS_CERT=
HORUS_WEBRTC_SIGNAL_TLS_KEY=
WEBRTC_DURATION=0
# Comma-separated ICE servers. Add TURN for NAT-heavy hub deployments, for example:
# WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,turn://user:pass@cloud.example.com:3478
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
# all prefers direct WebRTC and uses TURN only as fallback. relay forces TURN for validation/debugging.
# Optional explicit jitter-buffer budget in ms. Unset: direct/VPN 50, other profiles 100.
# WEBRTC_JITTER_BUFFER_MS=100
WEBRTC_ICE_TRANSPORT_POLICY=all
HORUS_WEBRTC_DEBUG_ICE=0
HORUS_CLOUD_RUN_TURN=0
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
TURN_REALM=horus
TURN_USER=horus
TURN_PASSWORD=change-me
TURN_PRIVATE_IP=
WEBRTC_MAX_BUFFER_BYTES=2000000
WEBRTC_VIDEO_WIDTH=1280
WEBRTC_VIDEO_HEIGHT=720
WEBRTC_VIDEO_FPS=30
WEBRTC_VIDEO_SOURCE=ros2
WEBRTC_VIDEO_OUTPUT=ros2
WEBRTC_VIDEO_SINK=fakesink
WEBRTC_GST_VIDEO_SOURCE=
WEBRTC_ROS_IMAGE_INPUT_TOPIC=/camera/image_raw
WEBRTC_ROS_IMAGE_OUTPUT_TOPIC=/camera/webrtc/image_raw
WEBRTC_ROS_IMAGE_OUTPUT_ENCODING=rgb8
WEBRTC_ROS_IMAGE_FRAME_ID=webrtc_camera
WEBRTC_ROS_IMAGE_QOS=auto
# Setup writes this file for one or more WebRTC camera tracks.
# Version 2 bundles all tracks into one peer connection; version 1 remains supported.
HORUS_STREAMS_CONFIG=config/webrtc_streams.json
HORUS_WEBRTC_SESSION_MODE=auto
HORUS_WEBRTC_SESSION_ROOM=
# Optional additional camera rooms on the robot in bundled hub mode. Each room
# starts an independent sender for an operator machine using that room.
HORUS_WEBRTC_ADDITIONAL_ROOMS=
# Optional explicit capacity budgets; 0 means no configured limit, not unlimited hardware.
WEBRTC_SESSION_BUDGET_KBIT=0
WEBRTC_MAX_OPERATORS=0
WEBRTC_MAX_ENCODED_PIXELS_PER_SEC=0
WEBRTC_TRACK_REPAIR_RETRY_SEC=3
WEBRTC_TRACK_REPAIR_LIMIT=1
WEBRTC_MAX_PIPELINE_REBUILDS=4
VIDEO_BITRATE_KBIT=6000
WEBRTC_ADAPTIVE_BITRATE=1
WEBRTC_MIN_BITRATE_KBIT=1000
WEBRTC_MAX_BITRATE_KBIT=6000
WEBRTC_BITRATE_STEP_KBIT=500
WEBRTC_BITRATE_CHECK_SEC=2.0
WEBRTC_BITRATE_BAD_LOSS=0.08
WEBRTC_BITRATE_GOOD_LOSS=0.02
WEBRTC_BITRATE_BAD_RTT_MS=350.0
WEBRTC_BITRATE_GOOD_RTT_MS=150.0
WEBRTC_BITRATE_GOOD_SAMPLES=3
WEBRTC_H264_KEY_INT_MAX=10
# WebRTC is video-only by default. Velocity commands stay on ROS 2 and cross the bridge through Zenoh.
WEBRTC_CONTROL_ENABLED=0
# Legacy alias kept for older local env files.
WEBRTC_ENABLE_CONTROL=0
# Required when WEBRTC_CONTROL_ENABLED=1. Share this token only with authorized operators.
HORUS_WEBRTC_CONTROL_TOKEN=
# Only set this to 1 for trusted lab tests where token-based control authorization is intentionally disabled.
WEBRTC_ALLOW_UNAUTHENTICATED_CONTROL=0
WEBRTC_CMD_MAX_LINEAR_MPS=0.5
WEBRTC_CMD_MAX_ANGULAR_RPS=1.0
WEBRTC_CMD_WATCHDOG_TIMEOUT=0.3
WEBRTC_CMD_RATE_LIMIT_HZ=100.0
WEBRTC_CMD_MAX_AGE_MS=2000.0
WEBRTC_CMD_MAX_FUTURE_MS=5000.0
# stable prefers the path proven by the end-to-end WebRTC/ROS test:
# x264/libav on normal Linux/NUC/WSL, Jetson hardware where required.
# Set hardware to opt into Jetson NVIDIA V4L2, Intel/DRM VAAPI, or NVIDIA NVENC first.
WEBRTC_ENCODER_PREFERENCE=stable
WEBRTC_DECODER_PREFERENCE=stable
# Intel systems install the free VA driver by default. Set non-free only if your hardware needs it.
HORUS_INTEL_MEDIA_DRIVER=free

# Field teammate relay. Used only when HORUS_ROLE=teammate.
FIELD_TEAMMATE_NAME=field_teammate_1
FIELD_TEAMMATE_HOLOLENS_HOST=
FIELD_TEAMMATE_PV_PORT=3810
FIELD_TEAMMATE_SPATIAL_INPUT_PORT=3814
FIELD_TEAMMATE_UMQ_PORT=3816
FIELD_TEAMMATE_MAP_FRAME=map
FIELD_TEAMMATE_PROFILE_HEIGHT=1.75
FIELD_TEAMMATE_CAMERA_HEIGHT=0.0
FIELD_TEAMMATE_FLOOR_HEIGHT=0.0
FIELD_TEAMMATE_POSE_ORIGIN=camera
FIELD_TEAMMATE_CONNECT_TIMEOUT=2.0
FIELD_TEAMMATE_RECONNECT_DELAY=1.0
FIELD_TEAMMATE_VIDEO_PROFILE=fast60
FIELD_TEAMMATE_RAW_IMAGE=0
FIELD_TEAMMATE_VIDEO_MODE=
FIELD_TEAMMATE_VIDEO_WIDTH=
FIELD_TEAMMATE_VIDEO_HEIGHT=
FIELD_TEAMMATE_VIDEO_FPS=
FIELD_TEAMMATE_VIDEO_QUALITY=
# Voice follows the same HORUS signaling host automatically. These are advanced overrides only.
HORUS_VOICE_ENABLED=1
FIELD_TEAMMATE_VOICE_SIGNALING_HOST=
FIELD_TEAMMATE_VOICE_TOKEN=

# In hub mode, the cloud relays WebRTC signaling only. It does not encode or decode media.
HORUS_CLOUD_RUN_SIGNALING=1
# Set this on robot, machine, and cloud to authenticate hub signaling rooms.
HORUS_WEBRTC_RELAY_TOKEN=
# Preferred production authentication: a JSON credential file with per-client role and room grants.
HORUS_WEBRTC_CREDENTIALS_FILE=
HORUS_WEBRTC_CLIENT_ID=
HORUS_WEBRTC_CLIENT_TOKEN=
# Optional coturn REST credentials issued by the signaling relay. TURN must use the same static-auth-secret.
HORUS_WEBRTC_TURN_PUBLIC_HOST=
HORUS_WEBRTC_TURN_SECRET=
HORUS_WEBRTC_TURN_TTL_SEC=3600
HORUS_WEBRTC_TURN_TRANSPORTS=udp,tcp
# Current research/development mode: tokenless voice only. Credential files still take precedence.
HORUS_VOICE_TRUSTED_DEVELOPMENT=1
# This broader switch also permits unauthenticated camera registrations; voice does not need it.
HORUS_WEBRTC_RELAY_ALLOW_UNAUTHENTICATED=0

# Synthetic camera stream used for validation/load testing.
FAKE_DATA_ROBOT_ID=robot-a
FAKE_ROS_IMAGE_TOPIC=/camera/image_raw
FAKE_ROS_ODOM_TOPIC=/odom
FAKE_ROS_SCAN_TOPIC=/scan
FAKE_ROS_JOINT_TOPIC=/joint_states
FAKE_ROS_POINTS_TOPIC=/points
FAKE_ROS_IMAGE_QOS=default
FAKE_CAMERA_WIDTH=1280
FAKE_CAMERA_HEIGHT=720
FAKE_CAMERA_FPS=30
FAKE_FRAME_CACHE=30
FAKE_STATE_RATE=20
FAKE_POINTS_RATE=1
FAKE_POINT_COUNT=512
FAKE_COLOR_SEED=17
CAMERA_FPS_SCALE=1.0
CAMERA_QUALITY_SCALE=1.0

# Runtime observability.
HORUS_LOG_KEEP=10
HORUS_METRICS_PORT=
HORUS_SERVICE_MAX_RESTARTS=5
HORUS_SERVICE_RESTART_WINDOW=300
HORUS_SERVICE_START_ATTEMPTS=100

# Machine/cloud-to-robot test control stream. Keep 0 unless deliberately testing.
CMD_RATE=0
CMD_LINEAR_X=0.0
CMD_ANGULAR_Z=0.0
