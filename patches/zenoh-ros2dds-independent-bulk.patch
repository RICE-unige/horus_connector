+fn reserve_bulk_slot(
+    next: &mut std::time::Instant,
+    now: std::time::Instant,
+    bytes: usize,
+    rate: u64,
+) -> Duration {
+    if rate == 0 {
+        return Duration::ZERO;
+    }
+    let start = (*next).max(now);
+    *next = start + Duration::from_secs_f64(bytes as f64 / rate as f64);
+    start.saturating_duration_since(now)
+}
+
+pub(crate) fn pace_bulk_sample(bytes: usize, rate: u64) {
+    let rate = crate::bulk_budget::effective_rate(rate);
+    if rate == 0 {
+        return;
+    }
+    // One shared schedule across bulk topics, with at most one held sample per
+    // reader. Sleeping never holds a DDS receive callback or this scheduling lock.
+    static NEXT: std::sync::LazyLock<std::sync::Mutex<std::time::Instant>> =
+        std::sync::LazyLock::new(|| std::sync::Mutex::new(std::time::Instant::now()));
+    let delay = {
+        let mut next = NEXT.lock().unwrap_or_else(|error| error.into_inner());
+        reserve_bulk_slot(&mut next, std::time::Instant::now(), bytes, rate)
+    };
+    if !delay.is_zero() {
+        std::thread::sleep(delay);
+    }
+}
+
