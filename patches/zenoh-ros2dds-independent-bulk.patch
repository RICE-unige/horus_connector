diff --git a/zenoh-plugin-ros2dds/src/bulk_budget.rs b/zenoh-plugin-ros2dds/src/bulk_budget.rs
new file mode 100644
index 0000000..6686d62
--- /dev/null
+++ b/zenoh-plugin-ros2dds/src/bulk_budget.rs
@@ -0,0 +1,60 @@
+// Copyright 2026 RICE Lab, University of Genoa
+// SPDX-License-Identifier: Apache-2.0
+
+use std::{path::Path, sync::{LazyLock, Mutex}, time::{Duration, Instant}};
+
+fn read_budget(path: &Path, fallback: u64, previous: Option<u64>) -> u64 {
+    let fresh = std::fs::metadata(path).ok().filter(|metadata| metadata.len() <= 32)
+        .and_then(|metadata| metadata.modified().ok())
+        .and_then(|modified| modified.elapsed().ok())
+        .is_some_and(|age| age <= Duration::from_secs(3));
+    if fresh {
+        if let Some(value) = std::fs::read_to_string(path).ok()
+            .and_then(|text| text.trim().parse::<u64>().ok())
+            .filter(|value| (1024..=1073741824).contains(value))
+        {
+            return value;
+        }
+    }
+    // A dead governor must not turn zero (unlimited) into a bulk flood.
+    let bounded = if fallback == 0 { 128000 } else { fallback.min(128000) };
+    previous.map_or(bounded, |rate| bounded.min(rate))
+}
+
+pub(crate) fn effective_rate(fallback: u64) -> u64 {
+    static PATH: LazyLock<Option<std::path::PathBuf>> = LazyLock::new(||
+        std::env::var_os("HORUS_ZENOH_BULK_BUDGET_FILE")
+            .filter(|path| !path.is_empty()).map(std::path::PathBuf::from));
+    static CACHE: LazyLock<Mutex<Option<(Instant, u64)>>> = LazyLock::new(|| Mutex::new(None));
+    let Some(path) = PATH.as_ref() else { return fallback; };
+    let mut cached = CACHE.lock().unwrap_or_else(|error| error.into_inner());
+    if let Some((at, rate)) = *cached {
+        if at.elapsed() < Duration::from_millis(100) { return rate; }
+    }
+    let rate = read_budget(path, fallback, cached.map(|(_, rate)| rate));
+    *cached = Some((Instant::now(), rate));
+    rate
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn missing_and_invalid_governors_never_enable_unlimited_bulk() {
+        let path = std::env::temp_dir().join(format!("horus-budget-{}", std::process::id()));
+        assert_eq!(read_budget(&path, 0, None), 128000);
+        std::fs::write(&path, "400000\n").unwrap();
+        assert_eq!(read_budget(&path, 0, None), 400000);
+        std::fs::write(&path, "0\n").unwrap();
+        assert_eq!(read_budget(&path, 1500000, None), 128000);
+        std::fs::write(&path, "invalid\n").unwrap();
+        assert_eq!(read_budget(&path, 64000, None), 64000);
+        assert_eq!(read_budget(&path, 1500000, Some(32000)), 32000);
+        std::fs::write(&path, "400000\n").unwrap();
+        let stale = std::time::SystemTime::now() - Duration::from_secs(4);
+        std::fs::File::open(&path).unwrap().set_times(std::fs::FileTimes::new().set_modified(stale)).unwrap();
+        assert_eq!(read_budget(&path, 0, Some(32000)), 32000);
+        std::fs::remove_file(path).unwrap();
+    }
+}
