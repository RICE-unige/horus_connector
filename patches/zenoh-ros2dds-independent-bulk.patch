+fn hmsh_forwarder(
+    publisher: Arc<AdvancedPublisher<'static>>,
+    route_id: String,
+    rate: u64,
+) -> Result<Box<dyn Fn(&DDSRawSample) + Send>, String> {
+    let capacity = std::env::var("HORUS_ZENOH_MESH_QUEUE_BYTES")
+        .unwrap_or_else(|_| "134217728".into())
+        .parse::<usize>()
+        .map_err(|_| "HORUS_ZENOH_MESH_QUEUE_BYTES must be a positive integer")?;
+    if !(1024..=1073741824).contains(&capacity) {
+        return Err("HORUS_ZENOH_MESH_QUEUE_BYTES must be 1024..1073741824".into());
+    }
+    let (sender, receiver) = crate::hmsh_queue::channel(capacity, 65536);
+    let name = route_id.clone();
+    std::thread::Builder::new()
+        .name("hmsh-publisher".into())
+        .stack_size(512 * 1024)
+        .spawn(move || {
+            while !receiver.closed() {
+                if let Some(bytes) = receiver.next(Duration::from_millis(100)) {
+                    pace_bulk_sample(bytes.len(), rate);
+                    if receiver.closed() {
+                        break;
+                    }
+                    if let Err(error) = publisher.put(bytes).wait() {
+                        tracing::error!("{name}: failed to forward HMSH page: {error}");
+                    }
+                }
+            }
+        })
+        .map_err(|error| format!("Error starting HMSH publisher: {error}"))?;
+    tracing::info!("{route_id}: full-replacement HMSH queue enabled (budget={capacity}, bulk_bytes_per_second={rate})");
+    Ok(Box::new(move |sample| {
+        if let Err(error) = sender.push(sample.data_as_slice().to_vec()) {
+            tracing::warn!("{route_id}: {error}");
+        }
+    }))
+}
