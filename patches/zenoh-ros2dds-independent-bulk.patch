+
+    #[test]
+    fn shared_budget_preserves_every_sample_without_idle_bursts() {
+        let now = std::time::Instant::now();
+        let mut next = now;
+        assert_eq!(reserve_bulk_slot(&mut next, now, 100, 1000), Duration::ZERO);
+        assert_eq!(
+            reserve_bulk_slot(&mut next, now, 200, 1000),
+            Duration::from_millis(100)
+        );
+        assert_eq!(
+            reserve_bulk_slot(&mut next, now, 50, 1000),
+            Duration::from_millis(300)
+        );
+        assert_eq!(
+            reserve_bulk_slot(&mut next, now + Duration::from_secs(10), 100, 1000),
+            Duration::ZERO
+        );
+        assert_eq!(reserve_bulk_slot(&mut next, now, 100, 0), Duration::ZERO);
+    }
+}
diff --git a/zenoh-plugin-ros2dds/src/hmsh_queue.rs b/zenoh-plugin-ros2dds/src/hmsh_queue.rs
new file mode 100644
index 0000000..f164a93
--- /dev/null
+++ b/zenoh-plugin-ros2dds/src/hmsh_queue.rs
@@ -0,0 +1,307 @@
+// Copyright 2026 RICE Lab, University of Genoa
+// SPDX-License-Identifier: Apache-2.0
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Debug)]
+struct Header {
+    chunk: u32,
+    epoch: u64,
+    revision: u64,
+    operation: u8,
+}
+
+// Only the full-replacement HMSH v2 contract is eligible. Unknown layouts,
+// ordinary ROS messages and malformed frames retain FIFO/backpressure behavior.
+fn header(cdr: &[u8]) -> Option<Header> {
+    if cdr.get(..4)? != [0, 1, 0, 0] || cdr.get(4..12)? != [0; 8] {
+        return None;
+    }
+    let length = u32::from_le_bytes(cdr.get(12..16)?.try_into().ok()?) as usize;
+    let payload = cdr.get(16..)?;
+    if payload.len() != length || payload.len() < 52 || &payload[..4] != b"HSMH" {
+        return None;
+    }
+    let u32_at = |offset| {
+        Some(u32::from_le_bytes(
+            payload.get(offset..offset + 4)?.try_into().ok()?,
+        ))
+    };
+    if u32_at(4)? != 2 || payload[40] > 2 || payload[41] > 1 {
+        return None;
+    }
+    let vertices = u32_at(44)? as usize;
+    let indices = u32_at(48)? as usize;
+    let expected = 52usize
+        .checked_add(vertices.checked_mul(if payload[41] == 1 { 16 } else { 12 })?)?
+        .checked_add(indices.checked_mul(4)?)?;
+    if expected != length
+        || indices % 3 != 0
+        || (payload[40] != 0 && (vertices != 0 || indices != 0))
+    {
+        return None;
+    }
+    Some(Header {
+        chunk: u32_at(8)?,
+        epoch: u64::from_le_bytes(payload[24..32].try_into().ok()?),
+        revision: u64::from_le_bytes(payload[32..40].try_into().ok()?),
+        operation: payload[40],
+    })
+}
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+enum Key {
+    Page(u32),
+    Clear,
+    Ordered(u64),
+}
+
+struct Packet {
+    bytes: Vec<u8>,
+    header: Option<Header>,
+}
+
+struct State {
+    packets: HashMap<Key, Packet>,
+    order: VecDeque<Key>,
+    bytes: usize,
+    epoch: Option<u64>,
+    serial: u64,
+    closed: bool,
+}
+
+struct Inner {
+    state: Mutex<State>,
+    changed: Condvar,
+    max_bytes: usize,
+    max_items: usize,
+}
+
+pub struct MeshSender(Arc<Inner>);
+pub struct MeshReceiver(Arc<Inner>);
+
+pub fn channel(max_bytes: usize, max_items: usize) -> (MeshSender, MeshReceiver) {
+    let inner = Arc::new(Inner {
+        state: Mutex::new(State {
+            packets: HashMap::new(),
+            order: VecDeque::new(),
+            bytes: 0,
+            epoch: None,
+            serial: 0,
+            closed: false,
+        }),
+        changed: Condvar::new(),
+        max_bytes,
+        max_items,
+    });
+    (MeshSender(inner.clone()), MeshReceiver(inner))
+}
+
+impl MeshSender {
+    pub fn push(&self, bytes: Vec<u8>) -> Result<bool, &'static str> {
+        if bytes.len() > self.0.max_bytes {
+            return Err("HMSH sample exceeds the configured queue byte budget");
+        }
+        let parsed = header(&bytes);
+        let mut state = self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        loop {
+            if state.closed {
+                return Err("HMSH sender is closed");
+            }
+            if let Some(h) = parsed {
+                if let Some(epoch) = state.epoch {
+                    if h.epoch < epoch || (h.epoch == epoch && h.operation == 2) {
+                        return Ok(false);
+                    }
+                }
+                if state.epoch != Some(h.epoch) {
+                    // A new map epoch supersedes its old full-replacement pages,
+                    // but cannot remove unknown/FIFO messages on this topic.
+                    state.packets.retain(|_, packet| packet.header.is_none());
+                    state.order.retain(|key| matches!(key, Key::Ordered(_)));
+                    state.bytes = state
+                        .packets
+                        .values()
+                        .map(|packet| packet.bytes.len())
+                        .sum();
+                    state.epoch = Some(h.epoch);
+                }
+            }
+            let key = match parsed {
+                Some(h) if h.operation == 2 => Key::Clear,
+                Some(h) => Key::Page(h.chunk),
+                None => Key::Ordered(state.serial),
+            };
+            let previous = state.packets.get(&key);
+            if let (Some(old), Some(new)) = (previous.and_then(|packet| packet.header), parsed) {
+                if new.revision <= old.revision {
+                    return Ok(false);
+                }
+            }
+            let old_bytes = previous.map_or(0, |packet| packet.bytes.len());
+            let replacement = previous.is_some();
+            if state.bytes - old_bytes + bytes.len() <= self.0.max_bytes
+                && (replacement || state.packets.len() < self.0.max_items)
+            {
+                state.bytes = state.bytes - old_bytes + bytes.len();
+                if !replacement {
+                    state.order.push_back(key);
+                }
+                if parsed.is_none() {
+                    state.serial = state.serial.wrapping_add(1);
+                }
+                state.packets.insert(
+                    key,
+                    Packet {
+                        bytes,
+                        header: parsed,
+                    },
+                );
+                self.0.changed.notify_all();
+                return Ok(true);
+            }
+            state = self
+                .0
+                .changed
+                .wait(state)
+                .unwrap_or_else(|error| error.into_inner());
+        }
+    }
+}
+
+impl MeshReceiver {
+    pub fn next(&self, timeout: Duration) -> Option<Vec<u8>> {
+        let mut state = self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        if state.order.is_empty() && !state.closed {
+            state = self
+                .0
+                .changed
+                .wait_timeout(state, timeout)
+                .unwrap_or_else(|error| error.into_inner())
+                .0;
+        }
+        if state.closed {
+            return None;
+        }
+        let key = state.order.pop_front()?;
+        let packet = state.packets.remove(&key)?;
+        state.bytes -= packet.bytes.len();
+        self.0.changed.notify_all();
+        Some(packet.bytes)
+    }
+
+    pub fn closed(&self) -> bool {
+        self.0
+            .state
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .closed
+    }
+}
+
+fn close(inner: &Inner) {
+    let mut state = inner
+        .state
+        .lock()
+        .unwrap_or_else(|error| error.into_inner());
+    state.closed = true;
+    inner.changed.notify_all();
+}
+
+impl Drop for MeshSender {
+    fn drop(&mut self) {
+        close(&self.0);
+    }
+}
+impl Drop for MeshReceiver {
+    fn drop(&mut self) {
+        close(&self.0);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn page(chunk: u32, epoch: u64, revision: u64, operation: u8) -> Vec<u8> {
+        let mut cdr = vec![0u8; 68];
+        cdr[1] = 1;
+        cdr[12..16].copy_from_slice(&52u32.to_le_bytes());
+        cdr[16..20].copy_from_slice(b"HSMH");
+        cdr[20..24].copy_from_slice(&2u32.to_le_bytes());
+        cdr[24..28].copy_from_slice(&chunk.to_le_bytes());
+        cdr[40..48].copy_from_slice(&epoch.to_le_bytes());
+        cdr[48..56].copy_from_slice(&revision.to_le_bytes());
+        cdr[56] = operation;
+        cdr
+    }
+
+    #[test]
+    fn latest_full_page_keeps_fifo_place_and_exact_bytes() {
+        let (send, receive) = channel(1024, 10);
+        send.push(page(1, 7, 1, 0)).unwrap();
+        send.push(page(2, 7, 1, 0)).unwrap();
+        let latest = page(1, 7, 5, 0);
+        send.push(latest.clone()).unwrap();
+        assert!(!send.push(page(1, 7, 4, 0)).unwrap());
+        assert_eq!(receive.next(Duration::ZERO), Some(latest));
+        assert_eq!(receive.next(Duration::ZERO), Some(page(2, 7, 1, 0)));
+    }
+
+    #[test]
+    fn epoch_clear_and_deletes_cannot_resurrect_old_geometry() {
+        let (send, receive) = channel(1024, 10);
+        send.push(page(1, 4, 1, 0)).unwrap();
+        send.push(page(0, 5, 0, 2)).unwrap();
+        send.push(page(1, 5, 1, 0)).unwrap();
+        assert!(!send.push(page(0, 5, 0, 2)).unwrap());
+        send.push(page(1, 5, 2, 1)).unwrap();
+        assert!(!send.push(page(1, 4, 3, 0)).unwrap());
+        assert_eq!(receive.next(Duration::ZERO), Some(page(0, 5, 0, 2)));
+        assert_eq!(receive.next(Duration::ZERO), Some(page(1, 5, 2, 1)));
+    }
+
+    #[test]
+    fn unknown_payloads_remain_ordered_and_bounded() {
+        let (send, receive) = channel(80, 1);
+        send.push(vec![7; 70]).unwrap();
+        let task = std::thread::spawn(move || {
+            send.push(vec![8; 70]).unwrap();
+            std::thread::sleep(Duration::from_millis(100));
+        });
+        std::thread::sleep(Duration::from_millis(10));
+        assert_eq!(receive.next(Duration::ZERO), Some(vec![7; 70]));
+        assert_eq!(receive.next(Duration::from_secs(1)), Some(vec![8; 70]));
+        task.join().unwrap();
+    }
+
+    #[test]
+    fn closing_unblocks_producer_and_consumer() {
+        let (send, receive) = channel(80, 1);
+        send.push(vec![1; 70]).unwrap();
+        let task = std::thread::spawn(move || send.push(vec![2; 70]));
+        drop(receive);
+        assert!(task.join().unwrap().is_err());
+    }
+
+    #[test]
+    fn invalid_or_nonempty_layouts_never_qualify_for_coalescing() {
+        let valid = page(9, 1, 1, 0);
+        assert!(header(&valid).is_some());
+        for offset in [0, 4, 8, 12, 16, 20, 56, 57, 60, 64] {
+            let mut invalid = valid.clone();
+            invalid[offset] = 99;
+            assert!(header(&invalid).is_none(), "offset={offset}");
+        }
+    }
+}
